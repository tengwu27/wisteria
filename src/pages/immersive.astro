---
import ImmersiveWorld, { type Exhibit } from '@/components/world/react/ImmersiveWorld';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMedia } from '@/assets/images/placeholders';
import { worldScene } from '@/data/world';
import { getPublishedEntries } from '@/lib/content';
import { byNewest, byOrder } from '@/utils/content';

const [art] = (await getPublishedEntries('art')).sort(byOrder);
const [lifestyle] = (await getPublishedEntries('lifestyle')).sort(byNewest);
const [travel] = (await getPublishedEntries('travel')).sort(byNewest);

const exhibits: Exhibit[] = [];
if (art) {
  exhibits.push({
    kind: 'painting',
    title: art.data.title,
    blurb: art.data.excerpt,
    image: getMedia(art.data.coverImage),
    imageAlt: art.data.coverAlt,
    href: `/art/${art.slug}`,
    cta: '走进画室看看'
  });
}
if (lifestyle) {
  exhibits.push({
    kind: 'book',
    title: lifestyle.data.title,
    blurb: lifestyle.data.excerpt,
    href: `/lifestyle/${lifestyle.slug}`,
    cta: '翻开这一页'
  });
}
if (travel) {
  exhibits.push({
    kind: 'postcard',
    title: travel.data.title,
    blurb: travel.data.excerpt,
    image: getMedia(travel.data.coverImage),
    imageAlt: travel.data.coverAlt,
    href: `/travel/${travel.slug}`,
    cta: '想起那趟旅程'
  });
}
---

<BaseLayout
  title="沉浸式小镇原型 | 我们的生活收藏"
  description="点击房子走进屋里：一个更像游戏的首页体验原型。"
>
  <div class="pt-[62px] md:pt-[70px]">
    <p class="iw-note">
      🧪 原型体验：点击<b>房子</b>走进屋里 · 屋里的画、手账和明信片都可以点
      <a class="underline" href="/">← 返回正式首页</a>
    </p>
    <h1 class="sr-only">沉浸式小镇原型：点击房子走进室内</h1>
    <ImmersiveWorld client:load scene={worldScene} exhibits={exhibits} />
  </div>
</BaseLayout>
