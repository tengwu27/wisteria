---
import { site } from '@/data/site';
import { absoluteUrl } from '@/utils/seo';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import '@/styles/immersive-font.css';
import '@/styles/immersive-viewport.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const title = Astro.props.title ?? site.seo.title;
const description = Astro.props.description ?? site.seo.description;
const type = Astro.props.type ?? 'website';
const canonical = absoluteUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-CN" class="immersive-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {Astro.props.image && <meta property="og:image" content={Astro.props.image} />}
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <ClientRouter />
    <script is:inline data-astro-rerun>
      {
        const viewportStateKey = '__wisteriaImmersiveViewport';
        const existingViewportState = window[viewportStateKey];

        if (existingViewportState) {
          existingViewportState.sync();
        } else {
          let viewportFrame = 0;
          const syncViewport = () => {
            viewportFrame = 0;
            const viewport = window.visualViewport;
            if (viewport && Math.abs(viewport.scale - 1) > 0.001) return;

            const width = viewport?.width ?? window.innerWidth;
            const height = viewport?.height ?? window.innerHeight;
            document.documentElement.style.setProperty(
              '--immersive-viewport-width',
              `${width}px`
            );
            document.documentElement.style.setProperty(
              '--immersive-viewport-height',
              `${height}px`
            );
          };
          const scheduleViewportSync = () => {
            window.cancelAnimationFrame(viewportFrame);
            viewportFrame = window.requestAnimationFrame(syncViewport);
          };

          window[viewportStateKey] = { sync: scheduleViewportSync };
          window.addEventListener('resize', scheduleViewportSync, {
            passive: true
          });
          window.addEventListener('orientationchange', scheduleViewportSync, {
            passive: true
          });
          window.visualViewport?.addEventListener(
            'resize',
            scheduleViewportSync,
            { passive: true }
          );
          syncViewport();
        }
      }
    </script>
  </head>
  <body class="bg-[#101d1b] text-ink antialiased">
    <main>
      <slot />
    </main>
  </body>
</html>
