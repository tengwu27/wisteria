---
import type { WorldObjectManifest, WorldSceneInstance } from '@/lib/world/types';
import { worldRectToPercent } from '@/lib/world/types';
import WorldLayer from './WorldLayer.astro';

interface Props {
  instance: WorldSceneInstance;
  manifest: WorldObjectManifest;
  canvas: { w: number; h: number };
  toneColor: string;
}

const { instance, manifest, canvas, toneColor } = Astro.props;
const { content } = instance;
const pos = worldRectToPercent(instance.at, canvas);

const styleParts = [
  `--left:${pos.left}`,
  `--top:${pos.top}`,
  `--width:${pos.width}`,
  `--height:${pos.height}`,
  `--label-tone:${toneColor}`
];
if (instance.labelAnchor) {
  styleParts.push(`--label-left:${instance.labelAnchor.left}`, `--label-bottom:${instance.labelAnchor.bottom}`);
}

const layers = [...manifest.layers].sort((a, b) => (a.z ?? 0) - (b.z ?? 0));
const flipRoot = Boolean(manifest.nativeFacing && instance.facing && manifest.nativeFacing !== instance.facing);
---

<a
  class={`world-hotspot world-hotspot--${instance.id}`}
  href={content.href}
  style={styleParts.join(';')}
  data-world-object
  data-id={instance.id}
  data-label={content.label}
  data-eyebrow={content.eyebrow}
  data-preview={content.preview}
  data-prompt={content.prompt}
  data-icon={content.icon}
  data-tone={content.tone}
  data-mobile-focus={instance.mobileFocus ? 'true' : undefined}
  aria-label={`${content.label}：${content.prompt}`}
>
  <span class="world-hotspot__parts" data-flip-x={flipRoot ? 'true' : undefined} aria-hidden="true">
    {layers.map((layer) => (
      <WorldLayer layer={layer} box={{ at: instance.at, canvas, facing: instance.facing }} />
    ))}
  </span>
  <span class="world-hotspot__label" aria-hidden="true">
    <span class="world-hotspot__label-icon">{content.icon}</span>
    <span><b>{content.label}</b><small>{content.eyebrow}</small></span>
    <span class="world-hotspot__label-arrow">➜</span>
  </span>
</a>
