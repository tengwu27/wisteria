---
import shell from '@/assets/images/world/house/v2/house-shell-v2.png?url';
import interior from '@/assets/images/world/house/v2/main-door-interior-v2.png?url';
import doorClosed from '@/assets/images/world/house/v2/main-door-closed-v2.png?url';
import doorOpen from '@/assets/images/world/house/v2/main-door-open-v2.png?url';
import foreground from '@/assets/images/world/house/v2/main-door-foreground-v2.png?url';
import fitMask from '@/assets/images/world/house/v2/main-door-fit-mask-v2.png?url';
import windowBackplates from '@/assets/images/world/house/v2/window-backplates-v2.png?url';
import windowsClosed from '@/assets/images/world/house/v2/windows-closed-v2.png?url';
import windowsOpen from '@/assets/images/world/house/v2/windows-open-v2.png?url';
import turbineMast from '@/assets/images/world/house/v2/turbine-mast-v2.png?url';
import turbineRotor from '@/assets/images/world/house/v2/turbine-rotor-v2.png?url';
import turbineHub from '@/assets/images/world/house/v2/turbine-hub-v2.png?url';
import roofFlag from '@/assets/images/world/house/v2/roof-flag-v2.png?url';
import lampOff from '@/assets/images/world/house/v2/wall-lamp-off-v2.png?url';
import lampOn from '@/assets/images/world/house/v2/wall-lamp-on-v2.png?url';
import clockBase from '@/assets/images/world/house/v2/clock-base-v2.png?url';
import worldBase from '@/assets/images/world/landscape/base-v2.png?url';
import contract from '@/assets/images/world/house/v2/house-v2.json';
import report from '@/assets/images/world/house/v2/validation-report.json';

const canvas = contract.canvas;
const socket = contract.sockets.mainDoor;
const pct = (value: number, total: number) => `${(value / total) * 100}%`;
const envelopeStyle = `left:${pct(socket.motionEnvelope.x, canvas.width)};top:${pct(socket.motionEnvelope.y, canvas.height)};width:${pct(socket.motionEnvelope.w, canvas.width)};height:${pct(socket.motionEnvelope.h, canvas.height)}`;
const apertureStyle = `left:${pct(socket.apertureRoi.x, canvas.width)};top:${pct(socket.apertureRoi.y, canvas.height)};width:${pct(socket.apertureRoi.w, canvas.width)};height:${pct(socket.apertureRoi.h, canvas.height)}`;
const pivotStyle = `left:${pct(socket.pivot.x, canvas.width)};top:${pct(socket.pivot.y, canvas.height)}`;
const hingeStyle = `left:${pct(socket.hingeLine.top.x, canvas.width)};top:${pct(socket.hingeLine.top.y, canvas.height)};height:${pct(socket.hingeLine.bottom.y - socket.hingeLine.top.y, canvas.height)}`;
const passCount = report.checks.filter((check) => check.pass).length;
---

<section class="asset-lab" style={`--world-base:url('${worldBase}')`} data-house-lab data-state="closed" data-window-state="closed" data-lamp-state="off" data-facing="mirrored" data-background="checker" data-zoom="100">
  <header class="asset-lab__header">
    <div>
      <p class="asset-lab__eyebrow">HOUSE PACKAGE · GEOMETRY GATE</p>
      <h1>Main House Component Workbench</h1>
      <p>Inspect the canonical package before any full-map adjustment. Every visible layer below shares one {canvas.width}×{canvas.height} canvas.</p>
    </div>
    <div class:list={['asset-lab__status', { 'is-pass': report.pass }]}>
      <b>{report.pass ? 'PASS' : 'FAIL'}</b>
      <span>{passCount}/{report.checks.length} automated checks</span>
    </div>
  </header>

  <div class="asset-lab__controls" aria-label="House asset controls">
    <fieldset>
      <legend>Door state</legend>
      <button type="button" data-state-button="closed" aria-pressed="true">Closed</button>
      <button type="button" data-state-button="open" aria-pressed="false">Open</button>
      <button type="button" data-play aria-pressed="false">▶ Play</button>
    </fieldset>
    <fieldset>
      <legend>Window state</legend>
      <button type="button" data-window-state-button="closed" aria-pressed="true">Windows closed</button>
      <button type="button" data-window-state-button="open" aria-pressed="false">Windows open</button>
    </fieldset>
    <fieldset>
      <legend>Lamp state</legend>
      <button type="button" data-lamp-state-button="off" aria-pressed="true">Lamp off</button>
      <button type="button" data-lamp-state-button="on" aria-pressed="false">Lamp on</button>
    </fieldset>
    <button type="button" data-motion aria-pressed="true">Motion on</button>
    <label>Facing
      <select data-facing-control>
        <option value="native">Native · bottom-right</option>
        <option value="mirrored" selected>World · bottom-left</option>
      </select>
    </label>
    <label>Background
      <select data-background-control>
        <option value="checker">Checkerboard</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="world">Local world crop</option>
      </select>
    </label>
    <label>Inspection
      <select data-zoom-control>
        <option value="100">100%</option>
        <option value="200">200%</option>
      </select>
    </label>
    <fieldset>
      <legend>Guides</legend>
      <label><input type="checkbox" data-guide="mask" /> Fit mask</label>
      <label><input type="checkbox" data-guide="bounds" /> Bounds</label>
      <label><input type="checkbox" data-guide="pivot" /> Pivot line</label>
      <label><input type="checkbox" data-guide="onion" /> Onion skin</label>
    </fieldset>
  </div>

  <div class="asset-lab__viewport">
    <div class="asset-lab__canvas">
      <div class="asset-lab__house" data-house-root>
        <img src={windowBackplates} width={canvas.width} height={canvas.height} alt="" />
        <img class="asset-lab__windows-closed" src={windowsClosed} width={canvas.width} height={canvas.height} alt="Closed window components mounted behind the house shell" />
        <img class="asset-lab__windows-open" src={windowsOpen} width={canvas.width} height={canvas.height} alt="Open window components mounted behind the house shell" />
        <img src={interior} width={canvas.width} height={canvas.height} alt="" />
        <img class="asset-lab__closed" src={doorClosed} width={canvas.width} height={canvas.height} alt="Closed main-door leaf" />
        <img class="asset-lab__open" src={doorOpen} width={canvas.width} height={canvas.height} alt="Open main-door leaf" />
        <img src={shell} width={canvas.width} height={canvas.height} alt="Main house foreground shell and aperture occluder" />
        <img src={foreground} width={canvas.width} height={canvas.height} alt="" />
        <img src={turbineMast} width={canvas.width} height={canvas.height} alt="Turbine mounting mast" />
        <img class="asset-lab__turbine" src={turbineRotor} width={canvas.width} height={canvas.height} alt="Algorithmically rotating turbine blades" />
        <img src={turbineHub} width={canvas.width} height={canvas.height} alt="Turbine foreground hub cap" />
        <img class="asset-lab__flag" src={roofFlag} width={canvas.width} height={canvas.height} alt="Roof flag" />
        <img class="asset-lab__lamp-off" src={lampOff} width={canvas.width} height={canvas.height} alt="Wall lamp off" />
        <img class="asset-lab__lamp-on" src={lampOn} width={canvas.width} height={canvas.height} alt="Wall lamp on" />
        <img src={clockBase} width={canvas.width} height={canvas.height} alt="Clock face mounted over the house shell" />
        <span class="asset-lab__clock-hand asset-lab__clock-hand--minute"></span>
        <span class="asset-lab__clock-hand asset-lab__clock-hand--hour"></span>
        <img class="guide guide--mask" src={fitMask} width={canvas.width} height={canvas.height} alt="" />
        <span class="guide guide--aperture" style={apertureStyle}></span>
        <span class="guide guide--envelope" style={envelopeStyle}></span>
        <span class="guide guide--pivot" style={pivotStyle}></span>
        <span class="guide guide--hinge" style={hingeStyle}></span>
        <img class="guide guide--onion" src={doorOpen} width={canvas.width} height={canvas.height} alt="" />
      </div>
    </div>
  </div>

  <section class="asset-lab__site-gate">
    <div>
      <p class="asset-lab__eyebrow">GATE 2 · LOCAL SITE CROP</p>
      <h2>Assembled-object placement</h2>
      <p>The world receives one position, scale, facing, and z-order. Child layers retain zero scene-specific offsets.</p>
    </div>
    <div class="asset-lab__site">
      <img class="asset-lab__site-bg" src={worldBase} width="2048" height="1152" alt="House placement site with the original baked house removed" />
      <div class="asset-lab__site-house" data-house-root>
        <img src={windowBackplates} alt="" />
        <img class="asset-lab__windows-closed" src={windowsClosed} alt="" />
        <img class="asset-lab__windows-open" src={windowsOpen} alt="" />
        <img src={interior} alt="" />
        <img class="asset-lab__closed" src={doorClosed} alt="" />
        <img class="asset-lab__open" src={doorOpen} alt="" />
        <img src={shell} alt="" />
        <img src={foreground} alt="" />
        <img src={turbineMast} alt="" />
        <img class="asset-lab__turbine" src={turbineRotor} alt="" />
        <img src={turbineHub} alt="" />
        <img class="asset-lab__flag" src={roofFlag} alt="" />
        <img class="asset-lab__lamp-off" src={lampOff} alt="" />
        <img class="asset-lab__lamp-on" src={lampOn} alt="" />
        <img src={clockBase} alt="" />
        <span class="asset-lab__clock-hand asset-lab__clock-hand--minute"></span>
        <span class="asset-lab__clock-hand asset-lab__clock-hand--hour"></span>
      </div>
    </div>
  </section>

  <details class="asset-lab__report">
    <summary>Automated validation details</summary>
    <ul>
      {report.checks.map((check) => <li class:list={{ 'is-pass': check.pass }}><b>{check.pass ? '✓' : '×'}</b> {check.name}</li>)}
    </ul>
  </details>
</section>

<script is:inline>
  const lab = document.querySelector('[data-house-lab]');
  if (lab) {
    let timer;
    const facingControl = lab.querySelector('[data-facing-control]');
    // Browsers may restore a previous select value across reloads. The lab's
    // deliberate initial view is always the integrated bottom-left direction.
    if (facingControl) facingControl.value = 'mirrored';
    lab.dataset.facing = 'mirrored';
    const setState = (state) => {
      lab.dataset.state = state;
      lab.querySelectorAll('[data-state-button]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.stateButton === state));
      });
    };
    const setComponentState = (datasetKey, state, selector) => {
      lab.dataset[datasetKey] = state;
      lab.querySelectorAll(selector).forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset[datasetKey + 'Button'] === state));
      });
    };
    lab.querySelectorAll('[data-state-button]').forEach((button) => {
      button.addEventListener('click', () => {
        window.clearInterval(timer);
        lab.querySelector('[data-play]')?.setAttribute('aria-pressed', 'false');
        setState(button.dataset.stateButton);
      });
    });
    lab.querySelector('[data-play]')?.addEventListener('click', (event) => {
      const button = event.currentTarget;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setState(lab.dataset.state === 'closed' ? 'open' : 'closed');
        return;
      }
      const playing = button.getAttribute('aria-pressed') === 'true';
      window.clearInterval(timer);
      button.setAttribute('aria-pressed', String(!playing));
      if (!playing) timer = window.setInterval(() => setState(lab.dataset.state === 'closed' ? 'open' : 'closed'), 850);
    });
    lab.querySelectorAll('[data-window-state-button]').forEach((button) => {
      button.addEventListener('click', () => setComponentState('windowState', button.dataset.windowStateButton, '[data-window-state-button]'));
    });
    lab.querySelectorAll('[data-lamp-state-button]').forEach((button) => {
      button.addEventListener('click', () => setComponentState('lampState', button.dataset.lampStateButton, '[data-lamp-state-button]'));
    });
    lab.querySelector('[data-motion]')?.addEventListener('click', (event) => {
      const enabled = event.currentTarget.getAttribute('aria-pressed') !== 'true';
      event.currentTarget.setAttribute('aria-pressed', String(enabled));
      lab.classList.toggle('is-motion-paused', !enabled);
    });
    facingControl?.addEventListener('change', (event) => lab.dataset.facing = event.target.value);
    lab.querySelector('[data-background-control]')?.addEventListener('change', (event) => lab.dataset.background = event.target.value);
    lab.querySelector('[data-zoom-control]')?.addEventListener('change', (event) => lab.dataset.zoom = event.target.value);
    lab.querySelectorAll('[data-guide]').forEach((control) => {
      control.addEventListener('change', () => lab.classList.toggle(`show-${control.dataset.guide}`, control.checked));
    });
  }
</script>

<style>
  .asset-lab { --ink: #252725; padding: 6rem clamp(1rem, 4vw, 4rem) 5rem; background: #efe4c8; color: var(--ink); font-family: 'LXGW WenKai', sans-serif; }
  .asset-lab__header, .asset-lab__site-gate { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; max-width: 1180px; margin: 0 auto 1.5rem; align-items: end; }
  .asset-lab h1, .asset-lab h2 { margin: 0.1rem 0 0.5rem; font-family: 'ZCOOL KuaiLe', sans-serif; line-height: 1; }
  .asset-lab h1 { font-size: clamp(2rem, 5vw, 4rem); }
  .asset-lab h2 { font-size: clamp(1.5rem, 3vw, 2.5rem); }
  .asset-lab p { max-width: 68ch; margin: 0; }
  .asset-lab__eyebrow { font-weight: 900; letter-spacing: 0.12em; }
  .asset-lab__status { display: grid; min-width: 10rem; border: 3px solid var(--ink); border-radius: 1rem; padding: 0.75rem 1rem; background: #e96f5f; box-shadow: 5px 6px 0 var(--ink); }
  .asset-lab__status.is-pass { background: #8ed59a; }
  .asset-lab__status b { font-size: 1.5rem; }
  .asset-lab__controls { position: sticky; top: 4.5rem; z-index: 20; display: flex; flex-wrap: wrap; gap: 0.75rem; max-width: 1180px; margin: 0 auto 1.5rem; border: 3px solid var(--ink); border-radius: 1rem; padding: 0.8rem; background: rgba(255,248,231,.96); box-shadow: 5px 6px 0 var(--ink); }
  .asset-lab__controls fieldset, .asset-lab__controls > label { display: flex; align-items: center; gap: 0.45rem; border: 0; margin: 0; padding: 0; font-weight: 800; }
  .asset-lab__controls legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .asset-lab button, .asset-lab select { border: 2px solid var(--ink); border-radius: 999px; background: white; padding: 0.45rem 0.7rem; font: inherit; font-weight: 800; }
  .asset-lab button[aria-pressed='true'] { background: #ffd64f; box-shadow: 2px 3px 0 var(--ink); }
  .asset-lab__viewport { max-width: 1180px; max-height: 75vh; margin: auto; overflow: auto; border: 3px solid var(--ink); border-radius: 1.25rem; background: #fff8e7; box-shadow: 7px 8px 0 var(--ink); }
  .asset-lab__canvas { position: relative; width: calc(780px * var(--zoom, 1)); height: calc(975px * var(--zoom, 1)); overflow: hidden; background-color: #ddd; background-image: linear-gradient(45deg,#bbb 25%,transparent 25%),linear-gradient(-45deg,#bbb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#bbb 75%),linear-gradient(-45deg,transparent 75%,#bbb 75%); background-size: 32px 32px; background-position: 0 0,0 16px,16px -16px,-16px 0; }
  [data-zoom='200'] { --zoom: 2; }
  [data-background='light'] .asset-lab__canvas { background: #fff8e7; }
  [data-background='dark'] .asset-lab__canvas { background: #18262a; }
  [data-background='world'] .asset-lab__canvas { background-image: var(--world-base); background-size: 3698px 2080px; background-position: -1480px -36px; }
  .asset-lab__house { position: absolute; inset: 0; width: 780px; height: 975px; transform: scale(var(--zoom,1)); transform-origin: top left; }
  [data-facing='mirrored'] [data-house-root] { transform: scaleX(-1); }
  [data-facing='mirrored'] .asset-lab__house { transform: scale(var(--zoom,1)) scaleX(-1); transform-origin: top center; }
  .asset-lab__house > img, .asset-lab__site-house > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .asset-lab__open { opacity: 0; transition: opacity 150ms linear; }
  .asset-lab__closed { opacity: 1; transition: opacity 150ms linear; }
  [data-state='open'] .asset-lab__open { opacity: 1; }
  [data-state='open'] .asset-lab__closed { opacity: 0; }
  .asset-lab__windows-open, .asset-lab__lamp-on { opacity: 0; transition: opacity 150ms linear; }
  .asset-lab__windows-closed, .asset-lab__lamp-off { opacity: 1; transition: opacity 150ms linear; }
  [data-window-state='open'] .asset-lab__windows-open, [data-lamp-state='on'] .asset-lab__lamp-on { opacity: 1; }
  [data-window-state='open'] .asset-lab__windows-closed, [data-lamp-state='on'] .asset-lab__lamp-off { opacity: 0; }
  .asset-lab__turbine { transform-origin: 44.87% 9.44%; animation: house-turbine 2.6s linear infinite; }
  .asset-lab__flag { transform-origin: 68.72% 10.77%; animation: house-flag .9s ease-in-out infinite alternate; }
  .asset-lab__clock-hand { position: absolute; z-index: 5; display: block; width: .38%; border-radius: 999px; background: #28302b; transform-origin: 50% 100%; box-shadow: 0 0 0 1px rgba(190,119,32,.7); }
  .asset-lab__clock-hand--minute { left: 51.48%; top: 45.44%; height: 2.67%; animation: house-clock 60s linear infinite; }
  .asset-lab__clock-hand--hour { left: 51.54%; top: 46.05%; width: .48%; height: 2.05%; animation: house-clock 720s linear infinite; }
  .is-motion-paused :is(.asset-lab__turbine,.asset-lab__flag,.asset-lab__clock-hand) { animation-play-state: paused; }
  .guide { display: none !important; pointer-events: none; }
  .show-mask .guide--mask { display: block !important; opacity: .46; filter: sepia(1) saturate(8) hue-rotate(75deg); }
  .show-bounds .guide--aperture, .show-bounds .guide--envelope { display: block !important; position: absolute; box-sizing: border-box; border: 2px dashed #00d8ff; }
  .show-bounds .guide--envelope { border-color: #ff4f87; }
  .show-pivot .guide--pivot { display: block !important; position: absolute; z-index: 2; width: 14px; height: 14px; transform: translate(-50%,-50%); border: 3px solid white; border-radius: 50%; background: #ff8a00; box-shadow: 0 0 0 2px #252725; }
  .show-pivot .guide--hinge { display: block !important; position: absolute; z-index: 1; width: 5px; transform: translateX(-50%); border-radius: 999px; background: repeating-linear-gradient(to bottom,#ff8a00 0 7px,transparent 7px 12px); filter: drop-shadow(0 0 1px white); }
  .show-onion .guide--onion { display: block !important; opacity: .36 !important; filter: hue-rotate(115deg) saturate(2); }
  .asset-lab__site-gate { grid-template-columns: minmax(240px,.55fr) minmax(420px,1.45fr); margin-top: 4rem; align-items: start; }
  .asset-lab__site { position: relative; width: 100%; aspect-ratio: 850 / 650; overflow: hidden; border: 3px solid var(--ink); border-radius: 1rem; background: #86aa51; box-shadow: 6px 7px 0 var(--ink); }
  .asset-lab__site-bg { position: absolute; left: -76.47%; top: 0; width: 240.94%; height: 177.23%; max-width: none; }
  .asset-lab__site-house { position: absolute; left: 20%; top: 3.08%; width: 50.82%; height: 83.08%; transform-origin: center; }
  .asset-lab__report { max-width: 1180px; margin: 2rem auto 0; border: 3px solid var(--ink); border-radius: 1rem; background: #fff8e7; padding: 1rem; }
  .asset-lab__report summary { cursor: pointer; font-weight: 900; }
  .asset-lab__report ul { display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: .5rem; padding: 0; list-style: none; }
  .asset-lab__report li { border: 2px solid var(--ink); border-radius: .6rem; padding: .5rem; background: #f7b1aa; }
  .asset-lab__report li.is-pass { background: #ccebcf; }
  @keyframes house-turbine { to { transform: rotate(360deg); } }
  @keyframes house-flag { from { transform: perspective(100px) rotateY(-7deg) skewY(-2deg); } to { transform: perspective(100px) rotateY(7deg) skewY(3deg); } }
  @keyframes house-clock { from { transform: rotate(18deg); } to { transform: rotate(378deg); } }
  @media (max-width: 800px) { .asset-lab__header, .asset-lab__site-gate { grid-template-columns: 1fr; } .asset-lab__controls { position: static; } }
  @media (prefers-reduced-motion: reduce) {
    .asset-lab__open, .asset-lab__closed, .asset-lab__windows-open, .asset-lab__windows-closed, .asset-lab__lamp-on, .asset-lab__lamp-off { transition: none; }
    .asset-lab__turbine, .asset-lab__flag, .asset-lab__clock-hand { animation: none; }
  }
</style>
