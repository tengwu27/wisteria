---
import { getMedia, type MediaKey } from '@/assets/images/placeholders';

interface Props {
  title: string;
  href: string;
  imageKey: MediaKey;
  alt: string;
  meta?: string;
  excerpt?: string;
  large?: boolean;
  compact?: boolean;
}

const { title, href, imageKey, alt, meta, excerpt, large = false, compact = false } = Astro.props;
---

<a class={`group block ${large ? 'md:col-span-2' : ''}`} href={href}>
  <div class="media-frame overflow-hidden bg-mist">
    <img
      class={`w-full object-cover transition duration-500 group-hover:scale-[1.04] ${large ? 'aspect-[16/9]' : 'aspect-[4/5]'}`}
      src={getMedia(imageKey)}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="mt-6 max-w-2xl">
    {meta && <p class="inline-block -rotate-1 rounded-full border-2 border-ink bg-sunshine px-3 py-1 text-xs font-black text-ink">{meta}</p>}
    <h2 class={`mt-3 font-comic font-black leading-none text-ink decoration-tomato decoration-4 underline-offset-4 group-hover:underline ${compact ? 'text-4xl lg:text-5xl' : 'text-4xl md:text-6xl'}`}>{title}</h2>
    {excerpt && <p class={`${compact ? 'mt-3 text-sm leading-6' : 'mt-4 text-base leading-7'} font-bold text-graphite`}>{excerpt}</p>}
  </div>
</a>
