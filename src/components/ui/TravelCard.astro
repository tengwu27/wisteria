---
import { getMedia } from '@/assets/images/placeholders';
import type { TravelEntry } from '@/lib/content';

interface Props {
  entry: TravelEntry;
}

const { entry } = Astro.props;
---

<a class="group block" href={`/travel/${entry.slug}`}>
  <div class="media-frame overflow-hidden bg-mist">
    <img class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.04]" src={getMedia(entry.data.coverImage)} alt={entry.data.coverAlt} loading="lazy" decoding="async" />
  </div>
  <div class="pt-5">
    <p class="inline-block rounded-full border-2 border-ink bg-sky px-3 py-1 text-xs font-black">{entry.data.year} / {entry.data.country}</p>
    <h2 class="mt-3 font-comic text-3xl font-black leading-tight text-ink decoration-tomato decoration-4 underline-offset-4 group-hover:underline">{entry.data.destination}</h2>
    <p class="mt-3 text-sm font-semibold leading-6 text-graphite">{entry.data.excerpt}</p>
  </div>
</a>
