---
import ContentRenderer from './ContentRenderer.astro';
import type { AnyContentEntry } from '@/lib/content';

interface Props {
  entry: AnyContentEntry;
}

const { entry } = Astro.props;
let Content;

if ('render' in entry) {
  const rendered = await entry.render();
  Content = rendered.Content;
}
---

<ContentRenderer>
  {Content ? <Content /> : <div class="contents" set:html={'bodyHtml' in entry ? entry.bodyHtml : ''} />}
</ContentRenderer>
