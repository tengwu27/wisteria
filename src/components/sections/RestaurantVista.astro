import restaurantVista3072 from '../../../assets/cinematic/scenes/restaurant-vista-interior/delivery/restaurant-vista-patio-3072.webp';
import cafeVista from '../../../assets/cinematic/scenes/windmill-cafe-interior/delivery/windmill-cafe-approved.webp';
