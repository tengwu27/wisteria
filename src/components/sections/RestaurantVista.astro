import workshopVista1672 from '../../../assets/cinematic/scenes/workshop-interior/delivery/workshop-1672.webp';
import workshopVista2508 from '../../../assets/cinematic/scenes/workshop-interior/delivery/workshop-2508.webp';
import workshopVista3072 from '../../../assets/cinematic/scenes/workshop-interior/delivery/workshop-3072.webp';
import factoryVista from '../../../assets/cinematic/scenes/coffee-factory-interior/delivery/coffee-factory-approved.webp';
import libraryVista2048 from '../../../assets/cinematic/scenes/library-grand-hall/delivery/library-grand-hall-2048.webp';
import libraryVista3072 from '../../../assets/cinematic/scenes/library-grand-hall/delivery/library-grand-hall-3072.webp';
