---
import { navigation } from '@/data/navigation';

const mediaRoot = '/media/village';
---

<section class="cinematic-village" data-cinematic-village aria-label="动态村庄地图">
  <div
    class="cinematic-village__viewport"
    data-village-viewport
    tabindex="0"
    aria-label="村庄全景；在窄屏设备上可以左右滑动探索"
  >
    <div class="cinematic-village__camera" data-village-camera>
      <div class="cinematic-village__stage" data-village-stage>
        <video
          class="cinematic-village__scene is-active"
          data-scene-video="day"
          data-src={`${mediaRoot}/ambient/day-v5.mp4`}
          data-poster={`${mediaRoot}/ambient/day-v5-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
        <video
          class="cinematic-village__scene"
          data-scene-video="night"
          data-src={`${mediaRoot}/ambient/night-v3.mp4`}
          data-poster={`${mediaRoot}/ambient/night-v3-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>

        <div class="cinematic-village__shade" aria-hidden="true"></div>

        <button
          class="cinematic-village__house"
          type="button"
          data-house-trigger
          aria-label="进入主屋并打开生活页面"
        >
          <span class="cinematic-village__hotspot-ring" aria-hidden="true"></span>
          <span class="cinematic-village__hotspot-label" aria-hidden="true">
            <span>进入主屋</span>
            <small>ENTER</small>
          </span>
        </button>

        <button
          class="cinematic-village__car"
          type="button"
          data-car-trigger
          aria-label="走向汽车并打开旅行页面"
        >
          <span class="cinematic-village__hotspot-ring" aria-hidden="true"></span>
          <span class="cinematic-village__hotspot-label" aria-hidden="true">
            <span>走向汽车</span>
            <small>DRIVE</small>
          </span>
        </button>

        <button
          class="cinematic-village__cafe"
          type="button"
          data-cafe-trigger
          aria-label="穿过花园进入咖啡馆画廊"
        >
          <span class="cinematic-village__hotspot-ring" aria-hidden="true"></span>
          <span class="cinematic-village__hotspot-label" aria-hidden="true">
            <span>进入画廊</span>
            <small>VISIT</small>
          </span>
        </button>

        <button
          class="cinematic-village__garage"
          type="button"
          data-garage-trigger
          aria-label="进入摩托车工坊"
        >
          <span class="cinematic-village__hotspot-ring" aria-hidden="true"></span>
          <span class="cinematic-village__hotspot-label" aria-hidden="true">
            <span>进入工坊</span>
            <small>WORKSHOP</small>
          </span>
        </button>
      </div>
      <div
        class="cinematic-village__cloud-layer"
        data-village-cloud-layer
        aria-hidden="true"
      >
        <img
          src={`${mediaRoot}/ambient/clouds-day-near-v2.webp`}
          alt=""
          decoding="async"
        />
      </div>
    </div>
  </div>

  <header class="cinematic-village__hud" data-village-hud>
    <a
      href="/about"
      class="cinematic-village__profile"
      aria-label="打开关于 Wisteria 的页面"
    >
      <span class="cinematic-village__profile-avatar" aria-hidden="true">★</span>
      <span class="cinematic-village__profile-copy">
        <b>玩家 01</b>
        <small>世界收藏家 · Lv.12</small>
      </span>
    </a>
    <details class="cinematic-village__menu">
      <summary aria-label="打开主菜单">
        <span aria-hidden="true">☰</span>
        <span>菜单</span>
      </summary>
      <nav aria-label="主导航">
        {navigation.map((item) => <a href={item.href}>→ {item.label}</a>)}
      </nav>
    </details>
  </header>

  <p class="cinematic-village__swipe-cue" data-swipe-cue aria-hidden="true">
    <span>←</span>
    <span class="cinematic-village__swipe-copy">左右滑动探索</span>
    <span class="cinematic-village__edge-copy">将光标移至边缘探索</span>
    <span>→</span>
  </p>

  <div
    class="cinematic-village__welcome"
    data-welcome-overlay
    aria-hidden="true"
    tabindex="-1"
  >
    <img
      class="cinematic-village__welcome-logo"
      data-welcome-logo
      data-src="/media/village/ui/welcome-to-wisteria.webp"
      alt="Welcome to Wisteria"
      decoding="sync"
      fetchpriority="high"
    />
    <p
      class="cinematic-village__welcome-fallback"
      data-welcome-fallback
      aria-hidden="true"
    >
      <span>Welcome to</span>
      <strong>Wisteria</strong>
    </p>
    <p class="sr-only">欢迎来到 Wisteria。点击、轻触或按键可以跳过开场。</p>
  </div>

  <div class="cinematic-village__controls">
    <button
      class="cinematic-village__environment-toggle"
      type="button"
      data-environment-toggle
      aria-label="切换为夜景"
      aria-pressed="false"
    >
      <span class="cinematic-village__toggle-icon" data-toggle-icon aria-hidden="true">☀</span>
      <span data-toggle-label>白昼</span>
    </button>
    <p class="cinematic-village__hint" aria-hidden="true">探索主屋、咖啡馆、摩托车工坊，或开车去旅行</p>
  </div>

  <p class="sr-only" data-village-status aria-live="polite"></p>

  <div
    class="cinematic-village__entry"
    data-entry-overlay
    aria-label="进入场景的过渡动画；点击可以跳过"
    aria-hidden="true"
  >
    <video
      class="cinematic-village__transition-video is-active"
      data-interaction-video
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
    <div class="cinematic-village__entry-vignette" aria-hidden="true"></div>
    <p class="cinematic-village__entry-skip" aria-hidden="true">
      点击跳过
    </p>
    <div class="cinematic-village__curtain" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { navigate } from 'astro:transitions/client';
  import {
    loadDeferredVideo,
    releaseDeferredVideo
  } from '@/utils/cinematicMediaLoader';

  const SESSION_KEY = 'wisteria-hero-environment';
  const RETURN_SESSION_KEY = 'wisteria-village-return';
  const INTRO_SESSION_KEY = 'wisteria-village-intro-seen';

  type Environment = 'day' | 'night';
  type Interaction = 'house' | 'car' | 'cafe' | 'garage';

  const destinations: Record<Interaction, string> = {
    house: '/lifestyle',
    car: '/travel',
    cafe: '/art',
    garage: '/garage'
  };
  const sceneMedia: Record<Environment, { src: string; poster: string }> = {
    day: {
      src: '/media/village/ambient/day-v5.mp4',
      poster: '/media/village/ambient/day-v5-poster.webp'
    },
    night: {
      src: '/media/village/ambient/night-v3.mp4',
      poster: '/media/village/ambient/night-v3-poster.webp'
    }
  };
  const interactionMedia: Record<
    Interaction,
    Record<Environment, { src: string; poster: string }>
  > = {
    house: {
      day: {
        src: '/media/living-room/transitions/house-door/door-day-v4.mp4',
        poster: '/media/living-room/transitions/house-door/door-day-v4-poster.webp'
      },
      night: {
        src: '/media/living-room/transitions/house-door/door-night-v4.mp4',
        poster: '/media/living-room/transitions/house-door/door-night-v4-poster.webp'
      }
    },
    car: {
      day: {
        src: '/media/car-interior/transitions/driver-door/driver-door-day-v6.mp4',
        poster: '/media/car-interior/transitions/driver-door/driver-door-day-v6-poster.webp'
      },
      night: {
        src: '/media/car-interior/transitions/driver-door/driver-door-night-v6.mp4',
        poster: '/media/car-interior/transitions/driver-door/driver-door-night-v6-poster.webp'
      }
    },
    cafe: {
      day: {
        src: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-day-v1.mp4',
        poster: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-day-v1-poster.webp'
      },
      night: {
        src: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-night-v1.mp4',
        poster: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-night-v1-poster.webp'
      }
    },
    garage: {
      day: {
        src: '/media/garage-workshop/transitions/garden-reveal/garage-reveal-day-v1.mp4',
        poster: '/media/garage-workshop/transitions/garden-reveal/garage-reveal-day-v1-poster.webp'
      },
      night: {
        src: '/media/garage-workshop/transitions/garden-reveal/garage-reveal-night-v1.mp4',
        poster: '/media/garage-workshop/transitions/garden-reveal/garage-reveal-night-v1-poster.webp'
      }
    }
  };

  function getStoredEnvironment(): Environment | null {
    try {
      const stored = window.sessionStorage.getItem(SESSION_KEY);
      return stored === 'day' || stored === 'night' ? stored : null;
    } catch {
      return null;
    }
  }

  function getLocalEnvironment(): Environment {
    const hour = new Date().getHours();
    return hour >= 7 && hour < 19 ? 'day' : 'night';
  }

  function initialiseCinematicVillage() {
    type VillageRoot = HTMLElement & {
      __wisteriaVillageLifecycle?: AbortController;
    };
    const root = document.querySelector<VillageRoot>('[data-cinematic-village]');
    if (!root) return;

    const priorLifecycle = root.__wisteriaVillageLifecycle;
    if (
      root.dataset.ready === 'true' &&
      priorLifecycle &&
      !priorLifecycle.signal.aborted
    ) return;
    priorLifecycle?.abort();
    delete root.dataset.ready;

    const viewport = root.querySelector<HTMLElement>('[data-village-viewport]');
    const camera = root.querySelector<HTMLElement>('[data-village-camera]');
    const stage = root.querySelector<HTMLElement>('[data-village-stage]');
    const cloudLayer = root.querySelector<HTMLElement>(
      '[data-village-cloud-layer]'
    );
    const hud = root.querySelector<HTMLElement>('[data-village-hud]');
    const welcome = root.querySelector<HTMLElement>('[data-welcome-overlay]');
    const welcomeLogo = root.querySelector<HTMLImageElement>('[data-welcome-logo]');
    const welcomeFallback = root.querySelector<HTMLElement>(
      '[data-welcome-fallback]'
    );
    const swipeCue = root.querySelector<HTMLElement>('[data-swipe-cue]');
    const houseTrigger = root.querySelector<HTMLButtonElement>('[data-house-trigger]');
    const carTrigger = root.querySelector<HTMLButtonElement>('[data-car-trigger]');
    const cafeTrigger = root.querySelector<HTMLButtonElement>('[data-cafe-trigger]');
    const garageTrigger = root.querySelector<HTMLButtonElement>('[data-garage-trigger]');
    const environmentToggle = root.querySelector<HTMLButtonElement>('[data-environment-toggle]');
    const toggleIcon = root.querySelector<HTMLElement>('[data-toggle-icon]');
    const toggleLabel = root.querySelector<HTMLElement>('[data-toggle-label]');
    const status = root.querySelector<HTMLElement>('[data-village-status]');
    const overlay = root.querySelector<HTMLElement>('[data-entry-overlay]');
    const dayVideo = root.querySelector<HTMLVideoElement>('[data-scene-video="day"]');
    const nightVideo = root.querySelector<HTMLVideoElement>('[data-scene-video="night"]');
    const transitionVideo = root.querySelector<HTMLVideoElement>(
      '[data-interaction-video]'
    );

    if (
      !viewport ||
      !camera ||
      !stage ||
      !cloudLayer ||
      !hud ||
      !welcome ||
      !welcomeLogo ||
      !welcomeFallback ||
      !swipeCue ||
      !houseTrigger ||
      !carTrigger ||
      !cafeTrigger ||
      !garageTrigger ||
      !environmentToggle ||
      !toggleIcon ||
      !toggleLabel ||
      !status ||
      !overlay ||
      !dayVideo ||
      !nightVideo ||
      !transitionVideo
    ) return;

    const lifecycle = new AbortController();
    root.__wisteriaVillageLifecycle = lifecycle;
    root.dataset.ready = 'true';
    const { signal } = lifecycle;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia(
      '(hover: hover) and (pointer: fine)'
    );
    const sceneVideos: Record<Environment, HTMLVideoElement> = {
      day: dayVideo,
      night: nightVideo
    };
    let returningFromScene = document.documentElement.classList.contains(
      'is-returning-to-village'
    );
    try {
      returningFromScene =
        returningFromScene ||
        window.sessionStorage.getItem(RETURN_SESSION_KEY) === '1';
      window.sessionStorage.removeItem(RETURN_SESSION_KEY);
    } catch {
      // The document-level veil remains authoritative when storage is blocked.
    }
    if (returningFromScene) {
      document.documentElement.classList.add('is-returning-to-village');
    }
    let environment: Environment = getStoredEnvironment() ?? getLocalEnvironment();
    let activeInteraction: Interaction = 'house';
    let activeTransitionVideo = transitionVideo;
    let activeTransitionMedia = interactionMedia[activeInteraction][environment];
    let activeDestination = destinations[activeInteraction];
    let introActive = document.documentElement.classList.contains(
      'is-village-intro-pending'
    );
    let entering = false;
    let finishing = false;
    let fallbackTimer = 0;
    let returnRevealTimer = 0;
    let returnCleanupTimer = 0;
    let introAssetTimer = 0;
    let introHoldTimer = 0;
    let introCleanupTimer = 0;
    let cameraFrame = 0;
    let resizeFrame = 0;
    let returnRevealed = false;
    let sceneVisualToken = 0;
    let viewportReady = false;
    let worldHasOverflow = false;
    let hasPositionedOverflow = false;
    let viewCenterRatio = 0.5;
    let cameraX = 0;
    let cameraY = 0;
    let cloudScrollX = 0;
    let targetCameraX = 0;
    let targetCameraY = 0;
    let panVelocity = 0;
    let targetPanVelocity = 0;
    let previousCameraTime = 0;

    const setSceneInteractive = (interactive: boolean) => {
      viewport.toggleAttribute('inert', !interactive);
      hud.toggleAttribute('inert', !interactive);
      houseTrigger.disabled = !interactive;
      carTrigger.disabled = !interactive;
      cafeTrigger.disabled = !interactive;
      garageTrigger.disabled = !interactive;
      environmentToggle.disabled = !interactive;
    };

    const writeCameraPosition = () => {
      camera.style.setProperty('--camera-x', `${cameraX.toFixed(2)}px`);
      camera.style.setProperty('--camera-y', `${cameraY.toFixed(2)}px`);
      const cloudFocusX = cameraX * 0.55 + cloudScrollX;
      const cloudFocusY = cameraY * 0.35;
      cloudLayer.style.setProperty(
        '--cloud-focus-x',
        `${cloudFocusX.toFixed(2)}px`
      );
      cloudLayer.style.setProperty(
        '--cloud-focus-y',
        `${cloudFocusY.toFixed(2)}px`
      );
    };

    const canAnimateCamera = () =>
      !introActive &&
      !entering &&
      !document.hidden &&
      !reduceMotion.matches;

    const animateCamera = (time: number) => {
      cameraFrame = 0;
      const elapsedSeconds = previousCameraTime
        ? Math.min(0.05, (time - previousCameraTime) / 1000)
        : 1 / 60;
      previousCameraTime = time;
      const easing = 1 - Math.exp(-elapsedSeconds * 8);
      cameraX += (targetCameraX - cameraX) * easing;
      cameraY += (targetCameraY - cameraY) * easing;
      panVelocity += (targetPanVelocity - panVelocity) * easing;

      if (
        worldHasOverflow &&
        canAnimateCamera() &&
        Math.abs(panVelocity) >= 0.1
      ) {
        const maxScroll = Math.max(
          0,
          viewport.scrollWidth - viewport.clientWidth
        );
        const nextScroll = Math.min(
          maxScroll,
          Math.max(
            0,
            viewport.scrollLeft + panVelocity * elapsedSeconds
          )
        );
        const reachedBoundary =
          nextScroll === viewport.scrollLeft &&
          ((nextScroll <= 0 && panVelocity < 0) ||
            (nextScroll >= maxScroll && panVelocity > 0));
        viewport.scrollLeft = nextScroll;
        if (reachedBoundary) {
          panVelocity = 0;
          targetPanVelocity = 0;
        }
      }

      const cameraSettled =
        Math.abs(targetCameraX - cameraX) < 0.05 &&
        Math.abs(targetCameraY - cameraY) < 0.05;
      const panSettled =
        Math.abs(targetPanVelocity - panVelocity) < 0.1 &&
        Math.abs(panVelocity) < 0.1;

      if (cameraSettled && panSettled) {
        cameraX = targetCameraX;
        cameraY = targetCameraY;
        panVelocity = targetPanVelocity;
        previousCameraTime = 0;
        writeCameraPosition();
        return;
      }

      writeCameraPosition();
      cameraFrame = window.requestAnimationFrame(animateCamera);
    };

    const scheduleCamera = () => {
      if (!cameraFrame) {
        cameraFrame = window.requestAnimationFrame(animateCamera);
      }
    };

    const resetCamera = (immediate = false) => {
      targetCameraX = 0;
      targetCameraY = 0;
      targetPanVelocity = 0;
      if (immediate) {
        window.cancelAnimationFrame(cameraFrame);
        cameraFrame = 0;
        previousCameraTime = 0;
        cameraX = 0;
        cameraY = 0;
        panVelocity = 0;
        writeCameraPosition();
        return;
      }
      scheduleCamera();
    };

    const canTrackCamera = () =>
      canAnimateCamera() && finePointer.matches;

    const updateViewCenterRatio = () => {
      if (!worldHasOverflow || viewport.scrollWidth <= 0) return;
      viewCenterRatio = Math.min(
        1,
        Math.max(
          0,
          (viewport.scrollLeft + viewport.clientWidth / 2) /
            viewport.scrollWidth
        )
      );
    };

    const updateCloudScrollParallax = () => {
      if (
        !worldHasOverflow ||
        reduceMotion.matches ||
        camera.offsetWidth <= 0
      ) {
        cloudScrollX = 0;
      } else {
        const visibleCenter =
          viewport.scrollLeft + viewport.clientWidth / 2;
        cloudScrollX =
          -(visibleCenter - camera.offsetWidth / 2) * 0.12;
      }
      writeCameraPosition();
    };

    const getDefaultViewCenterRatio = () => {
      const worldWidth = stage.offsetWidth || camera.offsetWidth;
      if (worldWidth <= 0) return 0.5;
      const carCenter = carTrigger.offsetLeft + carTrigger.offsetWidth / 2;
      return Math.min(1, Math.max(0, carCenter / worldWidth));
    };

    const positionWorldViewport = (preservePosition = true) => {
      resetCamera(true);
      viewportReady = false;
      window.requestAnimationFrame(() => {
        const measuredOverflow = Math.max(
          0,
          camera.offsetWidth - viewport.clientWidth
        );
        worldHasOverflow = measuredOverflow > 1;
        root.classList.toggle('has-world-overflow', worldHasOverflow);
        root.classList.toggle('has-fine-pointer', finePointer.matches);

        if (!worldHasOverflow) {
          viewport.scrollLeft = 0;
          updateCloudScrollParallax();
          viewportReady = true;
          return;
        }

        const maxScroll = Math.max(
          0,
          camera.offsetWidth - viewport.clientWidth
        );
        const ratio =
          preservePosition && hasPositionedOverflow
            ? viewCenterRatio
            : getDefaultViewCenterRatio();
        viewCenterRatio = ratio;
        hasPositionedOverflow = true;
        viewport.scrollLeft = Math.min(
          maxScroll,
          Math.max(
            0,
            ratio * camera.offsetWidth - viewport.clientWidth / 2
          )
        );
        updateCloudScrollParallax();
        window.requestAnimationFrame(() => {
          viewportReady = true;
          updateViewCenterRatio();
        });
      });
    };

    const markWelcomeSeen = () => {
      (
        window as Window & { __wisteriaVillageIntroSeen?: boolean }
      ).__wisteriaVillageIntroSeen = true;
      try {
        window.sessionStorage.setItem(INTRO_SESSION_KEY, '1');
      } catch {
        // The in-memory flag suppresses repeats when storage is unavailable.
      }
    };

    const revealWelcomeLogo = () => {
      if (
        !introActive ||
        root.classList.contains('is-intro-logo-visible') ||
        root.classList.contains('is-intro-fallback-visible')
      ) return;
      window.clearTimeout(introAssetTimer);
      window.requestAnimationFrame(() => {
        root.classList.add('is-intro-logo-visible');
      });
      introHoldTimer = window.setTimeout(
        finishWelcome,
        reduceMotion.matches ? 360 : 1400
      );
    };

    const revealWelcomeFallback = () => {
      if (
        !introActive ||
        root.classList.contains('is-intro-logo-visible') ||
        root.classList.contains('is-intro-fallback-visible')
      ) return;
      window.clearTimeout(introAssetTimer);
      welcomeFallback.setAttribute('aria-hidden', 'false');
      window.requestAnimationFrame(() => {
        root.classList.add('is-intro-fallback-visible');
      });
      introHoldTimer = window.setTimeout(
        finishWelcome,
        reduceMotion.matches ? 360 : 1400
      );
    };

    const finishWelcome = () => {
      if (!introActive || root.classList.contains('is-intro-leaving')) return;
      markWelcomeSeen();
      window.clearTimeout(introAssetTimer);
      window.clearTimeout(introHoldTimer);
      root.classList.add('is-intro-leaving');
      document.documentElement.classList.add(
        'is-village-intro-revealing'
      );

      introCleanupTimer = window.setTimeout(() => {
        introActive = false;
        document.documentElement.classList.remove(
          'is-village-intro-pending',
          'is-village-intro-revealing'
        );
        root.classList.remove(
          'is-intro-active',
          'is-intro-logo-visible',
          'is-intro-fallback-visible',
          'is-intro-leaving'
        );
        welcome.setAttribute('aria-hidden', 'true');
        welcomeFallback.setAttribute('aria-hidden', 'true');
        welcome.blur();
        if (!entering) setSceneInteractive(true);
        status.textContent = '欢迎来到 Wisteria 村庄';
        resetCamera();
      }, reduceMotion.matches ? 20 : 650);
    };

    const startWelcome = () => {
      if (!introActive) {
        document.documentElement.classList.remove(
          'is-village-intro-pending',
          'is-village-intro-revealing'
        );
        setSceneInteractive(true);
        return;
      }

      root.classList.add('is-intro-active');
      welcome.setAttribute('aria-hidden', 'false');
      setSceneInteractive(false);
      resetCamera(true);
      welcome.focus({ preventScroll: true });

      if (!welcomeLogo.hasAttribute('src') && welcomeLogo.dataset.src) {
        welcomeLogo.src = welcomeLogo.dataset.src;
      }

      if (welcomeLogo.complete && welcomeLogo.naturalWidth > 0) {
        revealWelcomeLogo();
      } else {
        welcomeLogo.addEventListener('load', revealWelcomeLogo, {
          once: true,
          signal
        });
        introAssetTimer = window.setTimeout(
          revealWelcomeFallback,
          reduceMotion.matches ? 120 : 10000
        );
      }
    };

    const safelyPlay = (video: HTMLVideoElement) => {
      const playback = video.play();
      playback?.catch(() => undefined);
      return playback;
    };

    const revealReturnedVillage = () => {
      if (!returningFromScene || returnRevealed) return;
      returnRevealed = true;
      window.clearTimeout(returnRevealTimer);
      requestAnimationFrame(() => {
        document.documentElement.classList.add(
          'is-returning-to-village-ready'
        );
        returnCleanupTimer = window.setTimeout(() => {
          document.documentElement.classList.remove(
            'is-returning-to-village',
            'is-returning-to-village-ready'
          );
        }, reduceMotion.matches ? 20 : 540);
      });
    };

    const markSceneVisualReady = (target: Environment) => {
      if (target !== environment || signal.aborted) return;
      root.classList.add('has-scene-visual');
      revealReturnedVillage();
    };

    const prepareScenePoster = (target: Environment) => {
      const token = ++sceneVisualToken;
      const poster = new Image();
      const markReady = () => {
        if (token !== sceneVisualToken || target !== environment) return;
        markSceneVisualReady(target);
      };

      poster.addEventListener('load', () => {
        if (typeof poster.decode === 'function') {
          poster.decode().then(markReady).catch(markReady);
        } else {
          markReady();
        }
      }, { once: true, signal });
      poster.src = sceneMedia[target].poster;
      if (poster.complete && poster.naturalWidth > 0) markReady();
    };

    const resumeActiveScene = () => {
      if (entering || document.hidden || !root.isConnected) return;
      loadDeferredVideo(sceneVideos[environment], sceneMedia[environment]);
      safelyPlay(sceneVideos[environment]);
    };

    const selectInteraction = (interaction: Interaction) => {
      activeInteraction = interaction;
      activeDestination = destinations[interaction];
      activeTransitionMedia = interactionMedia[interaction][environment];
      root.dataset.interaction = interaction;
    };

    const updateEnvironment = (next: Environment, persist = false) => {
      environment = next;
      root.dataset.environment = next;
      root.classList.remove('has-scene-visual');
      prepareScenePoster(next);

      (Object.entries(sceneVideos) as [Environment, HTMLVideoElement][]).forEach(([name, video]) => {
        const active = name === next;
        video.classList.toggle('is-active', active);
        if (active && !document.hidden && !entering) {
          loadDeferredVideo(video, sceneMedia[name]);
          safelyPlay(video);
        } else {
          releaseDeferredVideo(video);
        }
      });

      selectInteraction(activeInteraction);

      const showingNight = next === 'night';
      environmentToggle.setAttribute('aria-pressed', String(showingNight));
      environmentToggle.setAttribute('aria-label', showingNight ? '切换为白昼景色' : '切换为夜景');
      toggleIcon.textContent = showingNight ? '☾' : '☀';
      toggleLabel.textContent = showingNight ? '夜晚' : '白昼';
      status.textContent = showingNight ? '已切换为夜晚村庄' : '已切换为白昼村庄';

      if (persist) {
        try {
          window.sessionStorage.setItem(SESSION_KEY, next);
        } catch {
          // The visual toggle still works when storage is unavailable.
        }
      }
    };

    const navigateToDestination = async () => {
      window.clearTimeout(fallbackTimer);
      try {
        await navigate(activeDestination);
      } catch {
        window.location.assign(activeDestination);
      }
    };

    const finishEntry = () => {
      if (finishing) return;
      finishing = true;
      window.clearTimeout(fallbackTimer);
      // Keep the decoded frame mounted while the curtain closes. Releasing the
      // source here makes the video fall back to its poster before the curtain
      // is opaque, which produces a visible one-frame jump at the handoff.
      activeTransitionVideo.pause();
      overlay.classList.add('is-closing');
      window.setTimeout(navigateToDestination, reduceMotion.matches ? 220 : 320);
    };

    const startEntry = (interaction: Interaction) => {
      if (entering || introActive) return;
      selectInteraction(interaction);
      entering = true;
      root.classList.add('is-entering');
      document.body.classList.add('is-entering-cinematic');
      setSceneInteractive(false);
      resetCamera();
      status.textContent =
        interaction === 'house'
          ? '正在进入主屋'
          : interaction === 'cafe'
            ? '正在穿过花园前往咖啡馆画廊'
            : interaction === 'garage'
              ? '正在走向摩托车工坊'
              : '正在走向汽车';
      sceneVideos[environment].pause();
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-active');

      if (reduceMotion.matches) {
        requestAnimationFrame(() => finishEntry());
        return;
      }

      loadDeferredVideo(activeTransitionVideo, activeTransitionMedia);
      requestAnimationFrame(() => overlay.classList.add('is-playing'));

      const playback = activeTransitionVideo.play();
      playback?.catch(() => {
        window.setTimeout(finishEntry, 600);
      });

      fallbackTimer = window.setTimeout(
        finishEntry,
        interaction === 'cafe' ? 5400 : 4800
      );
    };

    const scheduleViewportPosition = (preservePosition = true) => {
      window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(() => {
        positionWorldViewport(preservePosition);
      });
    };
    const viewportObserver =
      typeof ResizeObserver === 'undefined'
        ? null
        : new ResizeObserver(() => scheduleViewportPosition(true));
    viewportObserver?.observe(viewport);
    viewportObserver?.observe(camera);

    updateEnvironment(environment);
    positionWorldViewport(false);
    startWelcome();

    viewport.addEventListener('pointermove', (event) => {
      if (!canTrackCamera() || event.pointerType === 'touch') return;
      const bounds = viewport.getBoundingClientRect();
      const normalizedX = Math.min(
        1,
        Math.max(-1, ((event.clientX - bounds.left) / bounds.width) * 2 - 1)
      );
      const normalizedY = Math.min(
        1,
        Math.max(-1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1)
      );
      targetCameraY = -normalizedY * bounds.height * 0.0075;

      if (worldHasOverflow) {
        targetCameraX = 0;
        const pointerX = event.clientX - bounds.left;
        const edgeZone = Math.min(
          220,
          Math.max(90, bounds.width * 0.2)
        );
        let edgeStrength = 0;
        if (pointerX < edgeZone) {
          edgeStrength = -(1 - pointerX / edgeZone);
        } else if (pointerX > bounds.width - edgeZone) {
          edgeStrength =
            (pointerX - (bounds.width - edgeZone)) / edgeZone;
        }
        const maximumSpeed = Math.min(
          850,
          Math.max(260, bounds.width * 0.55)
        );
        targetPanVelocity =
          Math.sign(edgeStrength) *
          Math.pow(Math.abs(edgeStrength), 1.65) *
          maximumSpeed;
      } else {
        targetPanVelocity = 0;
        targetCameraX = -normalizedX * bounds.width * 0.015;
      }
      scheduleCamera();
    }, { signal });

    viewport.addEventListener('pointerleave', () => {
      resetCamera();
    }, { signal });

    viewport.addEventListener('scroll', () => {
      if (!worldHasOverflow || !viewportReady) return;
      updateViewCenterRatio();
      updateCloudScrollParallax();
      root.classList.add('has-explored');
    }, { passive: true, signal });

    viewport.addEventListener('keydown', (event) => {
      if (
        !worldHasOverflow ||
        !viewportReady ||
        introActive ||
        entering
      ) return;

      const distance = Math.max(160, viewport.clientWidth * 0.72);
      let nextLeft: number | null = null;
      if (event.key === 'ArrowLeft') {
        nextLeft = viewport.scrollLeft - distance;
      } else if (event.key === 'ArrowRight') {
        nextLeft = viewport.scrollLeft + distance;
      } else if (event.key === 'Home') {
        nextLeft = 0;
      } else if (event.key === 'End') {
        nextLeft = viewport.scrollWidth;
      }

      if (nextLeft === null) return;
      event.preventDefault();
      viewport.scrollTo({
        left: nextLeft,
        behavior: reduceMotion.matches ? 'auto' : 'smooth'
      });
    }, { signal });

    welcome.addEventListener('pointerdown', (event) => {
      if (!introActive) return;
      event.preventDefault();
      event.stopPropagation();
      finishWelcome();
    }, { signal });

    welcomeLogo.addEventListener('error', () => {
      if (introActive) revealWelcomeFallback();
    }, { once: true, signal });

    document.addEventListener('keydown', (event) => {
      if (
        !introActive ||
        !['Enter', ' ', 'Escape'].includes(event.key)
      ) return;
      event.preventDefault();
      event.stopPropagation();
      finishWelcome();
    }, { signal });

    window.addEventListener('resize', () => {
      scheduleViewportPosition(true);
    }, { passive: true, signal });

    finePointer.addEventListener('change', () => {
      scheduleViewportPosition(true);
    }, { signal });

    reduceMotion.addEventListener('change', () => {
      resetCamera(true);
      scheduleViewportPosition(true);
    }, { signal });

    requestAnimationFrame(() => {
      root.classList.add('is-ready');
      window.setTimeout(resumeActiveScene, 80);
      window.setTimeout(resumeActiveScene, 500);
      if (
        returningFromScene &&
        sceneVideos[environment].readyState >=
          HTMLMediaElement.HAVE_CURRENT_DATA
      ) {
        requestAnimationFrame(() => markSceneVisualReady(environment));
      }
    });
    if (returningFromScene) {
      // Keep the return veil opaque while the active video or its decoded
      // poster becomes usable. The bounded fallback still prevents a failed
      // media request from trapping navigation indefinitely.
      returnRevealTimer = window.setTimeout(revealReturnedVillage, 5000);
    }

    (Object.entries(sceneVideos) as [Environment, HTMLVideoElement][]).forEach(([
      target,
      video
    ]) => {
      video.addEventListener('canplay', () => {
        if (video === sceneVideos[environment]) {
          resumeActiveScene();
          markSceneVisualReady(target);
        }
      }, { signal });
    });

    environmentToggle.addEventListener('click', () => {
      updateEnvironment(environment === 'day' ? 'night' : 'day', true);
    }, { signal });

    const bindInteractionTrigger = (
      trigger: HTMLButtonElement,
      interaction: Interaction
    ) => {
      trigger.addEventListener('click', () => startEntry(interaction), { signal });
      trigger.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        startEntry(interaction);
      }, { signal });
    };

    bindInteractionTrigger(houseTrigger, 'house');
    bindInteractionTrigger(carTrigger, 'car');
    bindInteractionTrigger(cafeTrigger, 'cafe');
    bindInteractionTrigger(garageTrigger, 'garage');
    overlay.addEventListener('pointerdown', (event) => {
      if (!entering || finishing) return;
      event.preventDefault();
      event.stopPropagation();
      status.textContent = '已跳过进入场景的过渡动画';
      finishEntry();
    }, { signal });
    activeTransitionVideo.addEventListener('ended', finishEntry, { signal });
    activeTransitionVideo.addEventListener('error', () => {
      if (entering) window.setTimeout(finishEntry, 400);
    }, { signal });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        dayVideo.pause();
        nightVideo.pause();
        resetCamera();
        return;
      }

      if (!entering) resumeActiveScene();
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      // Astro can restore this DOM from its page cache. Clear the marker before
      // aborting listeners so the restored village receives a fresh lifecycle
      // and reloads the released active media source.
      delete root.dataset.ready;
      delete root.__wisteriaVillageLifecycle;
      lifecycle.abort();
      window.clearTimeout(fallbackTimer);
      window.clearTimeout(returnRevealTimer);
      window.clearTimeout(returnCleanupTimer);
      window.clearTimeout(introAssetTimer);
      window.clearTimeout(introHoldTimer);
      window.clearTimeout(introCleanupTimer);
      window.cancelAnimationFrame(cameraFrame);
      window.cancelAnimationFrame(resizeFrame);
      viewportObserver?.disconnect();
      Object.values(sceneVideos).forEach((video) => releaseDeferredVideo(video));
      releaseDeferredVideo(activeTransitionVideo);
      document.body.classList.remove('is-entering-cinematic');
      document.documentElement.classList.remove(
        'is-village-intro-pending',
        'is-village-intro-revealing'
      );
    }, { once: true, signal });
  }

  initialiseCinematicVillage();
  document.addEventListener('astro:page-load', initialiseCinematicVillage);
</script>

