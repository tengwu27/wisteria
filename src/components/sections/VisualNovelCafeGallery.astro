---
import CinematicSceneExitOverlay from '@/components/media/CinematicSceneExitOverlay.astro';

const mediaRoot = '/media/cafe-gallery/ambient';
const parallaxRoot = '/media/cafe-gallery/parallax';
const registeredLayerStyle = ([x, y, width, height]: number[]) =>
  `--asset-x:${x / 16.72}%;--asset-y:${y / 9.41}%;` +
  `--asset-width:${width / 16.72}%;--asset-height:${height / 9.41}%`;
const tableRects = {
  day: [0, 543, 1366, 398],
  night: [0, 543, 1364, 398]
};
---

<section
  class="cafe-gallery is-ambient-paused"
  data-cafe-gallery
  data-state="arriving"
  data-renderer="fallback"
  aria-label="花园咖啡馆里的复古未来艺术画廊"
>
  <div
    class="cafe-gallery__viewport"
    data-gallery-viewport
    tabindex="0"
    aria-label="咖啡馆画廊全景；画面较宽时可以左右探索"
  >
    <div class="cafe-gallery__stage" data-gallery-stage>
      <div class="cafe-gallery__camera">
        <video
          class="cafe-gallery__video is-active"
          data-gallery-video="day"
          data-src={`${mediaRoot}/cafe-gallery-day-v1.mp4`}
          data-poster={`${mediaRoot}/cafe-gallery-day-v1-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
        <video
          class="cafe-gallery__video"
          data-gallery-video="night"
          data-src={`${mediaRoot}/cafe-gallery-night-v1.mp4`}
          data-poster={`${mediaRoot}/cafe-gallery-night-v1-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>

        {(['day', 'night'] as const).map((theme) => (
          <div
            class="cafe-gallery__stack"
            data-gallery-stack={theme}
            aria-hidden="true"
          >
            <div class="cafe-gallery__plane cafe-gallery__plane--exterior">
              <img
                data-gallery-layer-image={theme}
                data-src={`${parallaxRoot}/${theme}/01-garden-bay-exterior.webp`}
                alt=""
              />
            </div>
            <div class="cafe-gallery__plane cafe-gallery__plane--shell">
              <img
                data-gallery-layer-image={theme}
                data-src={`${parallaxRoot}/${theme}/02-gallery-shell.webp`}
                alt=""
              />
              {theme === 'night' && (
                <>
                  <span class="cafe-gallery__lamp-glow is-center"></span>
                  <span class="cafe-gallery__lamp-glow is-right"></span>
                </>
              )}
            </div>
            <div class="cafe-gallery__plane cafe-gallery__plane--tables">
              <img
                data-gallery-layer-image={theme}
                class="is-registered-sprite"
                style={registeredLayerStyle(tableRects[theme])}
                data-src={`${parallaxRoot}/${theme}/03-foreground-tables.webp`}
                alt=""
              />
              <div class="cafe-gallery__steam" aria-hidden="true">
                {Array.from({ length: 6 }, (_, index) => (
                  <span style={`--steam-index:${index}`}></span>
                ))}
              </div>
            </div>
          </div>
        ))}

        <div class="cafe-gallery__hotspot-plane">
          <button
            class="cafe-gallery__artwork"
            type="button"
            data-artwork-trigger
            aria-label="欣赏中央画作，打开艺术档案"
            disabled
          >
            <span class="cafe-gallery__artwork-glow" aria-hidden="true"></span>
            <span class="cafe-gallery__artwork-label" aria-hidden="true">
              <span>欣赏画作</span>
              <small>EXAMINE</small>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <p class="cafe-gallery__explore-cue" aria-hidden="true">
    <span>←</span>
    <span class="cafe-gallery__swipe-copy">左右滑动探索</span>
    <span class="cafe-gallery__edge-copy">将光标移至边缘探索</span>
    <span>→</span>
  </p>

  <a class="cafe-gallery__back" href="/" data-gallery-back aria-label="返回村庄">
    <span aria-hidden="true">←</span>
    <span>返回村庄</span>
  </a>

  <button
    class="cafe-gallery__theme-toggle"
    type="button"
    data-gallery-theme-toggle
    aria-label="切换为夜晚咖啡馆画廊"
    aria-pressed="false"
    disabled
  >
    <span class="cafe-gallery__theme-icon" data-gallery-theme-icon aria-hidden="true">☀</span>
    <span data-gallery-theme-label>白昼</span>
  </button>

  <p class="sr-only" data-gallery-status aria-live="polite">正在进入咖啡馆画廊</p>
  <CinematicSceneExitOverlay
    label="从咖啡馆画廊返回村庄的过渡动画"
    day={{
      src: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-day-v1-reverse.mp4',
      poster:
        '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-day-v1-reverse-poster.webp'
    }}
    night={{
      src: '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-night-v1-reverse.mp4',
      poster:
        '/media/cafe-gallery/transitions/garden-reveal/cafe-reveal-night-v1-reverse-poster.webp'
    }}
  />
  <div class="cafe-gallery__curtain" data-gallery-curtain aria-hidden="true"></div>
</section>

<script>
  import { navigate } from 'astro:transitions/client';
  import { createAdaptiveCinematicViewport } from '@/utils/adaptiveCinematicViewport';
  import { createCinematicExitSequence } from '@/utils/cinematicExitSequence';
  import {
    createLayerBundleLoader,
    loadDeferredVideo,
    scheduleCinematicWarmup,
    showDeferredVideoPoster
  } from '@/utils/cinematicMediaLoader';
  import { createHorizontalDepthParallax } from '@/utils/horizontalDepthParallax';

  const SESSION_KEY = 'wisteria-hero-environment';

  type Environment = 'day' | 'night';
  type RoomState = 'arriving' | 'idle' | 'exiting';

  const fallbackMedia: Record<Environment, { src: string; poster: string }> = {
    day: {
      src: '/media/cafe-gallery/ambient/cafe-gallery-day-v1.mp4',
      poster: '/media/cafe-gallery/ambient/cafe-gallery-day-v1-poster.webp'
    },
    night: {
      src: '/media/cafe-gallery/ambient/cafe-gallery-night-v1.mp4',
      poster: '/media/cafe-gallery/ambient/cafe-gallery-night-v1-poster.webp'
    }
  };

  function getStoredEnvironment(): Environment | null {
    try {
      const stored = window.sessionStorage.getItem(SESSION_KEY);
      return stored === 'day' || stored === 'night' ? stored : null;
    } catch {
      return null;
    }
  }

  function getLocalEnvironment(): Environment {
    const hour = new Date().getHours();
    return hour >= 7 && hour < 19 ? 'day' : 'night';
  }

  function initialiseCafeGallery() {
    const root = document.querySelector<HTMLElement>('[data-cafe-gallery]');
    if (!root || root.dataset.ready === 'true') return;

    const viewport = root.querySelector<HTMLElement>('[data-gallery-viewport]');
    const stage = root.querySelector<HTMLElement>('[data-gallery-stage]');
    const dayVideo = root.querySelector<HTMLVideoElement>('[data-gallery-video="day"]');
    const nightVideo = root.querySelector<HTMLVideoElement>('[data-gallery-video="night"]');
    const dayStack = root.querySelector<HTMLElement>('[data-gallery-stack="day"]');
    const nightStack = root.querySelector<HTMLElement>('[data-gallery-stack="night"]');
    const artworkTrigger = root.querySelector<HTMLButtonElement>('[data-artwork-trigger]');
    const backLink = root.querySelector<HTMLAnchorElement>('[data-gallery-back]');
    const themeToggle = root.querySelector<HTMLButtonElement>('[data-gallery-theme-toggle]');
    const themeIcon = root.querySelector<HTMLElement>('[data-gallery-theme-icon]');
    const themeLabel = root.querySelector<HTMLElement>('[data-gallery-theme-label]');
    const status = root.querySelector<HTMLElement>('[data-gallery-status]');
    const exitOverlay = root.querySelector<HTMLElement>(
      '[data-cinematic-scene-exit]'
    );

    if (
      !viewport ||
      !stage ||
      !dayVideo ||
      !nightVideo ||
      !dayStack ||
      !nightStack ||
      !artworkTrigger ||
      !backLink ||
      !themeToggle ||
      !themeIcon ||
      !themeLabel ||
      !status ||
      !exitOverlay
    ) return;

    root.dataset.ready = 'true';

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const videos: Record<Environment, HTMLVideoElement> = {
      day: dayVideo,
      night: nightVideo
    };
    const stacks: Record<Environment, HTMLElement> = {
      day: dayStack,
      night: nightStack
    };
    const bundleLoader = createLayerBundleLoader({
      stacks,
      imageSelector: '[data-gallery-layer-image]',
      signal
    });
    let environment: Environment = getStoredEnvironment() ?? getLocalEnvironment();
    let activeVideo = videos[environment];
    let state: RoomState = 'arriving';
    let renderer: 'layers' | 'fallback' = 'fallback';
    let themeLoading = false;
    let arrivalTimer = 0;
    let navigationTimer = 0;
    let themeTimer = 0;

    const adaptiveViewport = createAdaptiveCinematicViewport({
      root,
      viewport,
      world: stage,
      signal,
      initialCenterRatio: 0.5,
      isInteractive: () => state === 'idle'
    });

    const depth = createHorizontalDepthParallax({
      root,
      viewport,
      world: stage,
      signal,
      neutralCenterRatio: 0.5,
      isInteractive: () =>
        state === 'idle' &&
        renderer === 'layers' &&
        !themeLoading,
      planes: [
        { property: '--depth-exterior-x', maximumPercent: 0.22 },
        { property: '--depth-shell-x', maximumPercent: 0.55 },
        { property: '--depth-tables-x', maximumPercent: 1.35 }
      ]
    });

    const setState = (next: RoomState) => {
      state = next;
      root.dataset.state = next;
      root.classList.toggle('is-ambient-paused', next !== 'idle');
      depth.setSuspended(
        next !== 'idle' || renderer !== 'layers' || themeLoading,
        next !== 'idle'
      );
    };

    const loadBundle = bundleLoader.load;
    let inactiveWarmupScheduled = false;
    const scheduleInactiveWarmup = () => {
      if (inactiveWarmupScheduled) return;
      inactiveWarmupScheduled = true;
      scheduleCinematicWarmup(() => {
        const inactive = environment === 'day' ? 'night' : 'day';
        return loadBundle(inactive);
      }, signal);
    };

    const setRenderer = (next: 'layers' | 'fallback') => {
      renderer = next;
      root.dataset.renderer = next;
      if (next === 'layers') {
        Object.values(videos).forEach((video) => {
          video.pause();
          if (!video.hasAttribute('src')) video.removeAttribute('poster');
        });
      }
      depth.setSuspended(
        state !== 'idle' || next !== 'layers' || themeLoading,
        true
      );
    };

    const safelyPlay = (video = activeVideo) => {
      if (
        renderer !== 'fallback' ||
        reduceMotion.matches ||
        document.hidden ||
        state === 'exiting'
      ) return;
      const playback = video.play();
      playback
        ?.then(() => delete root.dataset.playback)
        .catch(() => {
          root.dataset.playback = `${environment}-poster`;
        });
    };

    const activateFallback = (theme: Environment, play = true) => {
      loadDeferredVideo(videos[theme], fallbackMedia[theme]);
      if (play) safelyPlay(videos[theme]);
    };

    const updateEnvironment = (
      next: Environment,
      persist = false,
      announce = false,
      initial = false
    ) => {
      const previousVideo = activeVideo;
      environment = next;
      activeVideo = videos[next];
      root.dataset.environment = next;
      stacks.day.classList.toggle('is-active', next === 'day');
      stacks.night.classList.toggle('is-active', next === 'night');

      if (renderer === 'fallback' && initial) {
        (Object.entries(videos) as [Environment, HTMLVideoElement][]).forEach(
          ([name, video]) => {
            video.classList.toggle('is-active', name === next);
            if (name !== next) video.pause();
          }
        );
        showDeferredVideoPoster(activeVideo, fallbackMedia[next]);
        if (activeVideo.hasAttribute('src')) safelyPlay(activeVideo);
      } else if (renderer === 'fallback' && previousVideo !== activeVideo) {
        window.clearTimeout(themeTimer);
        if (
          Number.isFinite(previousVideo.currentTime) &&
          Number.isFinite(activeVideo.duration) &&
          activeVideo.duration > 0
        ) {
          activeVideo.currentTime = previousVideo.currentTime % activeVideo.duration;
        }
        activeVideo.classList.add('is-active');
        safelyPlay(activeVideo);
        requestAnimationFrame(() => previousVideo.classList.remove('is-active'));
        themeTimer = window.setTimeout(() => previousVideo.pause(), 560);
      }

      const showingNight = next === 'night';
      themeToggle.setAttribute('aria-pressed', String(showingNight));
      themeToggle.setAttribute(
        'aria-label',
        showingNight ? '切换为白昼咖啡馆画廊' : '切换为夜晚咖啡馆画廊'
      );
      themeIcon.textContent = showingNight ? '☾' : '☀';
      themeLabel.textContent = showingNight ? '夜晚' : '白昼';

      if (announce) {
        status.textContent = showingNight ? '已切换为夜晚咖啡馆画廊' : '已切换为白昼咖啡馆画廊';
      }

      if (persist) {
        try {
          window.sessionStorage.setItem(SESSION_KEY, next);
        } catch {
          // Theme switching remains available when storage is blocked.
        }
      }

      if (
        renderer === 'layers' ||
        reduceMotion.matches ||
        document.hidden ||
        state === 'exiting'
      ) {
        Object.values(videos).forEach((video) => video.pause());
      } else if (initial || previousVideo === activeVideo) {
        safelyPlay(activeVideo);
      }
    };

    const finishArrival = () => {
      if (state !== 'arriving') return;
      window.clearTimeout(arrivalTimer);
      root.classList.add('is-revealed');
      status.textContent = '已进入咖啡馆画廊。可以查看中央画作。';

      window.setTimeout(() => {
        if (state !== 'arriving') return;
        setState('idle');
        root.classList.add('is-interactive');
        artworkTrigger.disabled = false;
        themeToggle.disabled = false;
        depth.setSuspended(renderer !== 'layers');
        depth.recalculate();
        scheduleInactiveWarmup();
      }, reduceMotion.matches ? 1 : 500);
    };

    const navigateTo = async (destination: string) => {
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      Object.values(videos).forEach((video) => video.pause());

      try {
        await navigate(destination);
      } catch {
        window.location.assign(destination);
      }
    };

    const exitSequence = createCinematicExitSequence({
      overlay: exitOverlay,
      reduceMotion,
      signal,
      onComplete: () => navigateTo('/')
    });

    const startCurtainExit = (destination: string, message: string) => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-exiting');
      artworkTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = message;
      adaptiveViewport.stopMotion(true);
      navigationTimer = window.setTimeout(
        () => navigateTo(destination),
        reduceMotion.matches ? 1 : 360
      );
    };

    const startVillageExit = () => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-returning');
      artworkTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = '正在离开咖啡馆画廊并返回村庄';
      adaptiveViewport.stopMotion(true);
      Object.values(videos).forEach((video) => video.pause());
      exitSequence.start(environment);
    };

    const resetAfterRestore = () => {
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      root.classList.remove('is-exiting');
      root.classList.remove('is-returning');
      exitSequence.reset();
      root.classList.add('is-revealed', 'is-interactive');
      backLink.removeAttribute('aria-disabled');
      artworkTrigger.disabled = false;
      themeToggle.disabled = false;
      setState('idle');
      adaptiveViewport.recalculate(true);
      depth.recalculate();
      status.textContent = '已回到咖啡馆画廊。可以查看中央画作。';
      updateEnvironment(getStoredEnvironment() ?? environment, false, false, true);
    };

    Object.values(videos).forEach((video) => {
      video.muted = true;
      video.addEventListener('loadeddata', () => {
        if (video === activeVideo) finishArrival();
      }, { signal });
      video.addEventListener('canplay', () => {
        if (video === activeVideo) finishArrival();
      }, { signal });
      video.addEventListener('error', () => {
        if (video !== activeVideo) return;
        root.dataset.playback = `${environment}-poster`;
        finishArrival();
      }, { signal });
    });

    updateEnvironment(environment, false, false, true);
    void loadBundle(environment).then((ready) => {
      if (signal.aborted || state === 'exiting') return;
      if (!ready) activateFallback(environment, false);
      setRenderer(ready ? 'layers' : 'fallback');
      updateEnvironment(environment, false, false, true);
      finishArrival();
    });

    if (reduceMotion.matches) {
      finishArrival();
    } else {
      if (activeVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        requestAnimationFrame(finishArrival);
      }

      arrivalTimer = window.setTimeout(finishArrival, 1400);
    }

    themeToggle.addEventListener('click', async () => {
      if (state !== 'idle' || themeLoading) return;
      const next: Environment = environment === 'day' ? 'night' : 'day';
      themeLoading = true;
      themeToggle.disabled = true;
      depth.setSuspended(true);
      const ready = await loadBundle(next);
      if (signal.aborted || state !== 'idle') return;
      if (!ready) activateFallback(next, false);
      setRenderer(ready ? 'layers' : 'fallback');
      updateEnvironment(next, true, true);
      window.clearTimeout(themeTimer);
      themeTimer = window.setTimeout(() => {
        themeLoading = false;
        themeToggle.disabled = false;
        depth.setSuspended(renderer !== 'layers');
      }, reduceMotion.matches ? 1 : 540);
    }, { signal });

    artworkTrigger.addEventListener('click', () => {
      startCurtainExit('/art/archive', '正在打开艺术档案');
    }, { signal });

    artworkTrigger.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      startCurtainExit('/art/archive', '正在打开艺术档案');
    }, { signal });

    backLink.addEventListener('click', (event) => {
      if (state !== 'idle') {
        event.preventDefault();
        return;
      }

      event.preventDefault();
      startVillageExit();
    }, { signal });

    document.addEventListener('visibilitychange', () => {
      root.classList.toggle('is-document-hidden', document.hidden);
      if (document.hidden) {
        Object.values(videos).forEach((video) => video.pause());
        depth.setSuspended(true, true);
      } else if (state === 'idle') {
        safelyPlay(activeVideo);
        depth.setSuspended(renderer !== 'layers');
      }
    }, { signal });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) resetAfterRestore();
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      lifecycle.abort();
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      exitSequence.pause();
      Object.values(videos).forEach((video) => video.pause());
    }, { once: true, signal });
  }

  initialiseCafeGallery();
  document.addEventListener('astro:page-load', initialiseCafeGallery);
</script>

<style>
  .cafe-gallery {
    --depth-exterior-x: 0px;
    --depth-shell-x: 0px;
    --depth-tables-x: 0px;
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #101d1b;
    color: #fff8e7;
  }

  .cafe-gallery__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, calc(100vh * 16 / 9));
    height: max(100vh, calc(100vw * 9 / 16));
    overflow: hidden;
    transform: translate(-50%, -50%);
  }

  .cafe-gallery__camera {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(1.035);
    transform-origin: 50% 50%;
  }

  .cafe-gallery__viewport {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    outline: none;
    overscroll-behavior: contain;
  }

  .cafe-gallery__viewport:focus-visible {
    outline: 3px solid #ffd64f;
    outline-offset: -5px;
  }

  .cafe-gallery.has-world-overflow .cafe-gallery__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
  }

  .cafe-gallery.has-world-overflow
  .cafe-gallery__viewport::-webkit-scrollbar {
    display: none;
  }

  .cafe-gallery.has-world-overflow .cafe-gallery__stage {
    position: relative;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  @supports (height: 100svh) {
    .cafe-gallery__stage {
      width: max(100vw, calc(100svh * 16 / 9));
      height: max(100svh, calc(100vw * 9 / 16));
    }
  }

  .cafe-gallery__video,
  .cafe-gallery__stack,
  .cafe-gallery__plane,
  .cafe-gallery__plane > img,
  .cafe-gallery__hotspot-plane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .cafe-gallery__video {
    z-index: 1;
    object-fit: fill;
    opacity: 0;
    transition: opacity 520ms ease;
  }

  .cafe-gallery[data-renderer='fallback'] .cafe-gallery__video.is-active {
    opacity: 1;
  }

  .cafe-gallery__stack {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 520ms ease;
  }

  .cafe-gallery[data-renderer='layers'] .cafe-gallery__stack.is-active {
    opacity: 1;
  }

  .cafe-gallery__plane > img {
    display: block;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
  }

  .cafe-gallery__plane > img.is-registered-sprite {
    inset: auto;
    left: var(--asset-x);
    top: var(--asset-y);
    width: var(--asset-width);
    height: var(--asset-height);
  }

  .cafe-gallery__plane--shell {
    z-index: 10;
    transform: translate3d(var(--depth-shell-x), 0, 0);
  }

  .cafe-gallery__plane--exterior {
    z-index: 5;
    transform: translate3d(var(--depth-exterior-x), 0, 0);
  }

  .cafe-gallery__plane--tables {
    z-index: 20;
    transform: translate3d(var(--depth-tables-x), 0, 0);
  }

  .cafe-gallery__hotspot-plane {
    z-index: 30;
    transform: translate3d(var(--depth-shell-x), 0, 0);
    pointer-events: none;
  }

  .cafe-gallery__artwork {
    pointer-events: auto;
  }

  .cafe-gallery__steam {
    position: absolute;
    left: 65.5%;
    top: 77.5%;
    width: 4.4%;
    height: 9%;
    pointer-events: none;
  }

  .cafe-gallery__steam span {
    --steam-index: 0;
    position: absolute;
