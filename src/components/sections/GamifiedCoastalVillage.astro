---
import holisticCandidate from '../../../assets/cinematic/scenes/gamified-coastal-village/isometric-parallax/registered/fallback.webp';
import cloudPlate from '../../../assets/cinematic/scenes/gamified-coastal-village/isometric-parallax/registered/01-clouds.webp';
import villagePlate from '../../../assets/cinematic/scenes/gamified-coastal-village/isometric-parallax/registered/02-village.webp';

const planningMode = false;
const compositionReview = true;
const camera = {
  zoom: 1.03,
  focalX: 0.674,
  focalY: 0.5
} as const;
type PlaneDefinition = { id: string; src: string; owner: string; z: number; pointerX: number; pointerY: number; spatialX: number; spatialY: number; minX?: number; maxX?: number };
type LandmarkDefinition = { id: string; zh: string; en: string; x: number; y: number; w: number; h: number; plane: string; route?: string };
const planes: PlaneDefinition[] = [
  { id: 'village', src: villagePlate.src, owner: 'registered isometric village, roads, farms, harbor, structures, vehicles, and factory', z: 2, pointerX: .28, pointerY: .09, spatialX: -.10, spatialY: -.04 },
  { id: 'clouds', src: cloudPlate.src, owner: 'near aerial cloud field', z: 5, pointerX: 2.124, pointerY: .756, spatialX: 1.548, spatialY: .612 },
];
const landmarks: LandmarkDefinition[] = [
  {
    id: 'castle',
    zh: '城堡',
    en: 'CASTLE',
    x: 39.5,
    y: 1,
    w: 23,
    h: 42.5,
    plane: 'village',
    route: '/castle'
  },
  {
    id: 'harbor',
    zh: '港湾观景厅',
    en: 'HARBOR VISTA',
    x: 30.6,
    y: 38.5,
    w: 12.3,
    h: 33,
    plane: 'village',
    route: '/harbor'
  },
  {
    id: 'restaurant',
    zh: '海湾餐厅',
    en: 'BAY RESTAURANT',
    x: 65.3,
    y: 38.26,
    w: 14.72,
    h: 31.88,
    plane: 'village',
    route: '/restaurant'
  },
  {
    id: 'cafe',
    zh: '风车咖啡馆',
    en: 'WINDMILL CAFÉ',
    x: 67.1,
    y: 17.6,
    w: 10.8,
    h: 28.4,
    plane: 'village',
    route: '/cafe'
  },
  {
    id: 'workshop',
    zh: '海湾工坊',
    en: 'BAY WORKSHOP',
    x: 50.8,
    y: 43.9,
    w: 13.4,
    h: 34.2,
    plane: 'village',
    route: '/workshop'
  },
  {
    id: 'library',
    zh: '大教堂图书馆',
    en: 'CATHEDRAL LIBRARY',
    x: 78.8,
    y: 3.4,
    w: 13.4,
    h: 34.6,
    plane: 'village',
    route: '/library'
  },
  {
    id: 'factory',
    zh: '咖啡工厂',
    en: 'COFFEE FACTORY',
    x: 81.2,
    y: 69.8,
    w: 10.8,
    h: 25.4,
    plane: 'village',
    route: '/factory'
  }
];
---

<section class="game" data-game-root data-camera-zoom={camera.zoom} data-camera-focal-x={camera.focalX} data-camera-focal-y={camera.focalY} data-review-mode={planningMode ? 'true' : undefined} data-composition-review={compositionReview ? 'true' : undefined} aria-label="Wisteria 海岸村庄多层视差原型">
  <div class="scene-viewport" data-scene-viewport tabindex="0" aria-label="可向四个方向探索的海岸村庄">
    <div class="scene-world" data-scene-world>
      <img class="fallback" src={holisticCandidate.src} alt="Wisteria 等距海岸村庄、城堡、港口、海湾工坊、咖啡工厂、风车咖啡馆与山城图书馆" data-fallback data-geography-master />
      <div class="layer-stack" data-layer-stack aria-hidden="true">
        {planes.map((plane) => (
          <div
            class:list={['plane', `plane-${plane.id}`]}
            data-plane={plane.id}
            data-owner={plane.owner}
            data-z={plane.z}
            data-pointer-x={plane.pointerX}
            data-pointer-y={plane.pointerY}
            data-spatial-x={plane.spatialX}
            data-spatial-y={plane.spatialY}
            data-min-x={plane.minX}
            data-max-x={plane.maxX}
            style={`z-index:${plane.z}`}
          >
            <div class="plane-ambient">
              <img data-src={plane.src} alt="" draggable="false" />
              {plane.id === 'village' && (
                <span class="factory-steam" aria-hidden="true">
                  <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                </span>
              )}
            </div>
            {landmarks.filter((landmark) => landmark.plane === plane.id).map((landmark) => (
              landmark.route ? (
                <a
                  class:list={['landmark', `landmark-${landmark.id}`]}
                  href={landmark.route}
                  data-immersive-route
                  data-landmark={landmark.id}
                  data-name-zh={landmark.zh}
                  data-name-en={landmark.en}
                  data-route={landmark.route}
                  style={`left:${landmark.x}%;top:${landmark.y}%;width:${landmark.w}%;height:${landmark.h}%`}
                  aria-label={`进入${landmark.zh} · ENTER ${landmark.en}`}
                ></a>
              ) : (
                <button
                  class:list={['landmark', `landmark-${landmark.id}`]}
                  type="button"
                  data-landmark={landmark.id}
                  data-name-zh={landmark.zh}
                  data-name-en={landmark.en}
                  style={`left:${landmark.x}%;top:${landmark.y}%;width:${landmark.w}%;height:${landmark.h}%`}
                  aria-label={`${landmark.zh} · ${landmark.en}`}
                ></button>
              )
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="landmark-label" data-landmark-label data-visible="false" aria-hidden="true">
    <span data-landmark-label-zh></span>
    <small data-landmark-label-en></small>
  </div>

  <header class="title-plaque" aria-label="Wisteria"><i></i><b>WISTERIA</b><i></i></header>
  <aside class="player-panel hud-panel">
    <div class="portrait" aria-hidden="true">⚓</div>
    <div class="needs" data-needs>
      <div><span>活力 <small>ENERGY</small></span><meter min="0" max="100" value="86"></meter></div>
      <div><span>灵感 <small>SPARK</small></span><meter min="0" max="100" value="74"></meter></div>
      <div><span>好奇 <small>WONDER</small></span><meter min="0" max="100" value="92"></meter></div>
      <div><span>心情 <small>MOOD</small></span><meter min="0" max="100" value="88"></meter></div>
    </div>
    <button class="drawer-button" type="button" data-drawer-toggle="needs">状态 <small>NEEDS</small></button>
  </aside>

  <aside class="quests hud-panel" data-drawer="quests">
    <h2>今日任务 <small>QUESTS</small></h2>
    <p data-quest="cafe"><span>☕</span> 拜访咖啡馆 <small>VISIT THE CAFÉ</small><b>◇</b></p>
    <p data-quest="map"><span>🗺</span> 寻找旧地图 <small>FIND THE OLD MAP</small><b>◇</b></p>
  </aside>

  <aside class="world-status">
    <div class="currency hud-panel"><span>◉</span><b data-currency>2,840</b></div>
    <div class="weather hud-panel"><span>☀</span><b>24°C</b><small>晴朗 · SUNNY</small></div>
  </aside>

  <nav class="actions hud-panel" aria-label="互动方式">
    <button type="button" data-action="explore" aria-pressed="true"><span>🥾</span>探索<small>EXPLORE</small></button>
    <button type="button" data-action="talk" aria-pressed="false"><span>💬</span>交谈<small>TALK</small></button>
    <button type="button" data-action="inspect" aria-pressed="false"><span>⌕</span>观察<small>INSPECT</small></button>
  </nav>

  <aside class="time-inventory">
    <div class="clock hud-panel">
      <div><strong>第 12 天</strong><small>DAY 12</small><time data-clock>09:00</time></div>
      <nav aria-label="时间速度">
        <button type="button" data-speed="0" aria-label="暂停">Ⅱ</button>
        <button type="button" data-speed="1" aria-label="正常速度" aria-pressed="true">▶</button>
        <button type="button" data-speed="3" aria-label="快速">▶▶</button>
      </nav>
    </div>
    <div class="inventory hud-panel" data-drawer="inventory">
      <h2>随身物品 <small>INVENTORY</small></h2>
      <div><span title="紫藤花">♣<b>12</b></span><span title="贝壳">◒<b>7</b></span><span title="海晶">◇<b>4</b></span><span data-map-item hidden title="旧地图">🗺<b>1</b></span></div>
    </div>
  </aside>

  <div class="mobile-tools">
    <button class="spatial" type="button" data-spatial-effect-toggle hidden><span aria-hidden="true">◎</span><span data-spatial-effect-label>空间感</span></button>
    <button type="button" data-drawer-toggle="quests">任务</button>
    <button type="button" data-drawer-toggle="inventory">物品</button>
  </div>
  <p class="swipe-cue" aria-hidden="true">↕ 滑动探索 · SWIPE TO EXPLORE ↔</p>
  <div class="dialogue hud-panel" data-dialogue role="status" aria-live="polite">
    <p>选择一种互动方式，然后探索村庄。</p><small>Choose an action, then discover the village.</small>
  </div>
  <div class="loading" data-loading data-immersive-loading aria-hidden="false"><span>正在准备海岸村庄…</span><small>PREPARING LAYERED VILLAGE</small></div>
</section>

<script>
  import { createPrototypeLayeredSceneController, type LayeredScenePlane } from '@/utils/prototypeLayeredScene';
  import { createDeviceOrientationSpatialEffect } from '@/utils/deviceOrientationSpatialEffect';
  import {
    afterCinematicPaint,
    waitForCinematicImage
  } from '@/utils/cinematicMediaLoader';
  import {
    NAVIGATION_START_EVENT,
    settleImmersiveArrival
  } from '@/utils/immersiveNavigation';

  const SESSION_KEY = 'wisteria-gamified-coastal-prototype';
  type ActionMode = 'explore' | 'talk' | 'inspect';
  type PrototypeState = { action: ActionMode; cafeDone: boolean; mapDone: boolean; currency: number; minutes: number; speed: number };
  const initialState: PrototypeState = { action: 'explore', cafeDone: false, mapDone: false, currency: 2840, minutes: 540, speed: 1 };

  function initGame() {
    const root = document.querySelector<HTMLElement>('[data-game-root]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const abort = new AbortController();
    const { signal } = abort;
    const viewport = root.querySelector<HTMLElement>('[data-scene-viewport]')!;
    const world = root.querySelector<HTMLElement>('[data-scene-world]')!;
    const stack = root.querySelector<HTMLElement>('[data-layer-stack]')!;
    const fallback = root.querySelector<HTMLImageElement>('[data-fallback]')!;
    const loading = root.querySelector<HTMLElement>('[data-loading]')!;
    const landmarkLabel = root.querySelector<HTMLElement>('[data-landmark-label]')!;
    const landmarkLabelZh = landmarkLabel.querySelector<HTMLElement>('[data-landmark-label-zh]')!;
    const landmarkLabelEn = landmarkLabel.querySelector<HTMLElement>('[data-landmark-label-en]')!;
    if (root.dataset.reviewMode === 'true') {
      const terrain = root.querySelector<HTMLImageElement>('[data-geography-master]')!;
      const reveal = () => {
        root.dataset.terrainReady = 'true';
        afterCinematicPaint(() => {
          loading.setAttribute('aria-hidden', 'true');
          settleImmersiveArrival();
        }, signal);
      };
      void waitForCinematicImage(terrain, { signal }).then(reveal);
      document.addEventListener('astro:before-swap', () => abort.abort(), { once: true });
      return;
    }
    const dialogue = root.querySelector<HTMLElement>('[data-dialogue]')!;
    const spatialButton = root.querySelector<HTMLButtonElement>('[data-spatial-effect-toggle]')!;
    let state = { ...initialState };
    try { state = { ...state, ...JSON.parse(sessionStorage.getItem(SESSION_KEY) ?? '{}') }; } catch {}
    const persist = () => { try { sessionStorage.setItem(SESSION_KEY, JSON.stringify(state)); } catch {} };
    const announce = (zh: string, en: string) => { dialogue.innerHTML = `<p>${zh}</p><small>${en}</small>`; };

    const planeRecords: LayeredScenePlane[] = [...root.querySelectorAll<HTMLElement>('[data-plane]')].map((element) => ({
      element,
      owner: element.dataset.owner ?? '',
      z: Number(element.dataset.z),
      pointerX: Number(element.dataset.pointerX),
      pointerY: Number(element.dataset.pointerY),
      spatialX: Number(element.dataset.spatialX),
      spatialY: Number(element.dataset.spatialY),
      minX: element.dataset.minX === undefined ? undefined : Number(element.dataset.minX),
      maxX: element.dataset.maxX === undefined ? undefined : Number(element.dataset.maxX),
      hotspotAssociation: [...element.querySelectorAll<HTMLElement>('[data-landmark]')].map((item) => item.dataset.landmark ?? '')
    }));
    const parallax = createPrototypeLayeredSceneController({
      root,
      viewport,
      world,
      planes: planeRecords,
      neutralFocalRatioX: Number(root.dataset.cameraFocalX),
      neutralFocalRatioY: Number(root.dataset.cameraFocalY),
      signal
    });
    const spatial = createDeviceOrientationSpatialEffect({
      button: spatialButton,
      signal,
      axes: 'both',
      isInteractive: () => root.dataset.layersReady === 'true' && !document.hidden,
      onFocus: (focus) => parallax.setSpatialFocus(focus),
      onStatus: (message) => { if (message) announce(message, 'SPATIAL EFFECT'); }
    });

    const updateState = () => {
      root.querySelectorAll<HTMLElement>('[data-action]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.action === state.action)));
      root.querySelectorAll<HTMLElement>('[data-speed]').forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.speed) === state.speed)));
      root.querySelector<HTMLElement>('[data-currency]')!.textContent = state.currency.toLocaleString();
      root.querySelector<HTMLElement>('[data-map-item]')!.hidden = !state.mapDone;
      for (const [quest, done] of [['cafe', state.cafeDone], ['map', state.mapDone]] as const) {
        const element = root.querySelector<HTMLElement>(`[data-quest="${quest}"]`)!;
        element.toggleAttribute('data-complete', done);
        element.querySelector('b')!.textContent = done ? '◆' : '◇';
      }
      const hours = Math.floor(state.minutes / 60) % 24;
      const minutes = Math.floor(state.minutes % 60);
      root.querySelector('time')!.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
      root.style.setProperty('--ambient-speed', state.speed === 0 ? '0' : String(1 / state.speed));
      root.toggleAttribute('data-paused', state.speed === 0);
    };
    updateState();

    root.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => button.addEventListener('click', () => {
      state.action = button.dataset.action as ActionMode;
      persist(); updateState(); announce(`${button.textContent?.trim()}模式已选择`, `${state.action.toUpperCase()} MODE`);
    }, { signal }));
    root.querySelectorAll<HTMLButtonElement>('[data-speed]').forEach((button) => button.addEventListener('click', () => {
      state.speed = Number(button.dataset.speed); persist(); updateState();
      announce(state.speed === 0 ? '村庄的时间暂停了。' : state.speed > 1 ? '海风和时钟加快了。' : '时间恢复到平静的步调。', 'TIME CONTROL UPDATED');
    }, { signal }));

    let labelledLandmark: HTMLElement | null = null;
    let labelFrame = 0;
    const positionLandmarkLabel = () => {
      if (!labelledLandmark) return;
      const rect = labelledLandmark.getBoundingClientRect();
      landmarkLabel.style.setProperty('--landmark-label-x', `${rect.left + rect.width / 2}px`);
      landmarkLabel.style.setProperty('--landmark-label-y', `${rect.bottom}px`);
      labelFrame = requestAnimationFrame(positionLandmarkLabel);
    };
    const showLandmarkLabel = (button: HTMLElement) => {
      labelledLandmark = button;
      landmarkLabelZh.textContent = button.dataset.nameZh ?? '';
      landmarkLabelEn.textContent = button.dataset.nameEn ?? '';
      landmarkLabel.dataset.landmark = button.dataset.landmark ?? '';
      landmarkLabel.dataset.visible = 'true';
      cancelAnimationFrame(labelFrame);
      positionLandmarkLabel();
    };
    const hideLandmarkLabel = (button: HTMLElement) => {
      if (labelledLandmark !== button) return;
      labelledLandmark = null;
      landmarkLabel.dataset.visible = 'false';
      cancelAnimationFrame(labelFrame);
    };

    root.querySelectorAll<HTMLElement>('[data-landmark]').forEach((button) => {
      const activateLandmark = () => {
      const id = button.dataset.landmark!;
      const name = button.dataset.nameZh!;
      if (id === 'cafe' && (state.action === 'explore' || state.action === 'talk')) {
        if (!state.cafeDone) { state.cafeDone = true; state.currency += 60; }
        announce('画廊咖啡馆飘来烘焙香气。任务完成：拜访咖啡馆。', 'QUEST COMPLETE · VISIT THE CAFÉ');
      } else if ((id === 'lighthouse' || id === 'harbor') && state.action === 'inspect') {
        if (!state.mapDone) { state.mapDone = true; state.currency += 90; }
        announce('你在旧航标盒里找到一张褪色的海湾地图。', 'OLD MAP ADDED TO INVENTORY');
      } else {
        const lines: Record<ActionMode, [string, string]> = {
          explore: [`你沿着通往${name}的小路继续探索。`, `EXPLORING ${button.dataset.nameEn}`],
          talk: [`${name}附近没有人回应，只有海风轻声经过。`, `THE COAST ANSWERS SOFTLY`],
          inspect: [`${name}带着盐雾与时光留下的细小痕迹。`, `A CLOSER LOOK REVEALS ITS HISTORY`]
        };
        announce(...lines[state.action]);
      }
      persist(); updateState();
      };
      button.addEventListener('pointerenter', () => showLandmarkLabel(button), { signal });
      button.addEventListener('pointerleave', () => hideLandmarkLabel(button), { signal });
      button.addEventListener('focus', () => showLandmarkLabel(button), { signal });
      button.addEventListener('blur', () => hideLandmarkLabel(button), { signal });
      if (button instanceof HTMLButtonElement) {
        button.addEventListener('click', activateLandmark, { signal });
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-drawer-toggle]').forEach((button) => button.addEventListener('click', () => {
      const drawer = button.dataset.drawerToggle!;
      const open = root.dataset.openDrawer === drawer;
      root.dataset.openDrawer = open ? '' : drawer;
      button.setAttribute('aria-expanded', String(!open));
    }, { signal }));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') root.dataset.openDrawer = ''; }, { signal });

    const clockTimer = window.setInterval(() => {
      if (document.hidden || state.speed <= 0) return;
      state.minutes = (state.minutes + state.speed * 2) % 1440;
      updateState();
      persist();
    }, 1000);

    const images = [...stack.querySelectorAll<HTMLImageElement>('img[data-src]')];
    const loadedLayers = new Set<HTMLImageElement>();
    let layersPromoted = false;
    let primarySettled = false;
    const deferFallbackArrival =
      document.documentElement.dataset.immersiveNavigating === 'true';
    const hideLoadingAfterPaint = () => {
      if (primarySettled) return;
      primarySettled = true;
      afterCinematicPaint(() => {
        loading.setAttribute('aria-hidden', 'true');
        settleImmersiveArrival();
      }, signal);
    };
    const promoteLayers = () => {
      if (layersPromoted || loadedLayers.size !== images.length || signal.aborted) return;
      layersPromoted = true;
      root.dataset.layersReady = 'true';
      delete root.dataset.fallback;
      stack.setAttribute('aria-hidden', 'false');
      fallback.setAttribute('aria-hidden', 'true');
      parallax.setSuspended(false);
      spatial.setSuspended(false);
      hideLoadingAfterPaint();
    };
    const markLayerReady = (image: HTMLImageElement) => {
      loadedLayers.add(image);
      promoteLayers();
    };
    const layerStates = Promise.all(images.map(async (image) => {
      image.src = image.dataset.src!;
      const result = await waitForCinematicImage(image, {
        signal,
        onLateReady: () => markLayerReady(image)
      });
      if (result === 'loaded') markLayerReady(image);
      return result;
    }));
    void layerStates.then((states) => {
      if (signal.aborted || states.every((state) => state === 'loaded')) return;
      root.dataset.fallback = 'true';
      parallax.setSuspended(true, true);
      spatial.setSuspended(true, true);
    });
    const fallbackState = waitForCinematicImage(fallback, {
      signal,
      onLateReady: deferFallbackArrival ? undefined : hideLoadingAfterPaint
    }).then((result) => {
      if (result === 'aborted' || layersPromoted) return result;
      root.dataset.fallback = 'true';
      parallax.setSuspended(true, true);
      spatial.setSuspended(true, true);
      if (!deferFallbackArrival) hideLoadingAfterPaint();
      if (result !== 'loaded') {
        announce('海岸画面仍在载入，你可以稍后重试。', 'VILLAGE ARTWORK IS STILL LOADING');
      }
      return result;
    });
    void Promise.all([layerStates, fallbackState]).then(() => {
      if (signal.aborted || layersPromoted || !deferFallbackArrival) return;
      hideLoadingAfterPaint();
    });

    const visibility = () => { const hidden = document.hidden; parallax.setSuspended(hidden, true); spatial.setSuspended(hidden, true); };
    document.addEventListener('visibilitychange', visibility, { signal });
    document.addEventListener(NAVIGATION_START_EVENT, () => {
      parallax.setSuspended(true, true);
      spatial.setSuspended(true, true);
    }, { signal });
    window.addEventListener('orientationchange', () => { spatial.recalibrate(); requestAnimationFrame(parallax.recalculate); }, { signal });
    document.addEventListener('astro:before-swap', () => {
      window.clearInterval(clockTimer);
      cancelAnimationFrame(labelFrame);
      abort.abort();
      parallax.destroy();
      spatial.destroy();
    }, { once: true });
  }
  initGame();
  document.addEventListener('astro:page-load', initGame);
</script>

<style>
  :global(html), :global(body), :global(main) { margin:0; width:100%; height:100%; overflow:hidden; background:var(--immersive-transition-background, #183d38); }
  .game { --cream:#f5dfaa; --teal:#0b6568; --deep:#073f44; --coral:#d86d49; --gold:#d5a63c; --line:#183d38; --ambient-speed:1; position:fixed; inset:0; width:var(--immersive-viewport-width,100dvw); height:var(--immersive-viewport-height,100dvh); overflow:hidden; color:#183d38; font-family:'Wisteria Immersive UI',system-ui,sans-serif; background:var(--immersive-transition-background, #183d38); }
  .scene-viewport { position:absolute; inset:0; overflow:auto; overscroll-behavior:contain; scrollbar-width:none; outline:none; touch-action:pan-x pan-y; -webkit-overflow-scrolling:touch; }
  .scene-viewport::-webkit-scrollbar { display:none; }
  .scene-world { position:relative; width:max(103%,calc(var(--immersive-viewport-height,100dvh) * 2.6401)); min-width:103%; min-height:103%; aspect-ratio:2412/941; overflow:hidden; }
  .fallback,.layer-stack,.plane,.plane-ambient,.plane img { position:absolute; inset:0; width:100%; height:100%; object-fit:fill; }
  .fallback { z-index:0; }
