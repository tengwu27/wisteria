---
import CinematicSceneExitOverlay from '@/components/media/CinematicSceneExitOverlay.astro';

const ambientRoot = '/media/living-room/ambient';
const parallaxRoot = '/media/living-room/parallax';
const registeredLayerStyle = ([x, y, width, height]: number[]) =>
  `--asset-x:${x / 16.72}%;--asset-y:${y / 9.41}%;` +
  `--asset-width:${width / 16.72}%;--asset-height:${height / 9.41}%`;
---

<section
  class="living-room is-ambient-paused"
  data-living-room
  data-state="arriving"
  data-renderer="fallback"
  aria-label="港湾主屋的复古未来客厅"
>
  <div
    class="living-room__viewport"
    data-room-viewport
    tabindex="0"
    aria-label="客厅全景；画面较宽时可以左右探索"
  >
    <div class="living-room__stage" data-room-stage>
      <div class="living-room__camera">
        <video
          class="living-room__fallback is-active"
          data-room-video="day"
          data-src={`${ambientRoot}/living-room-multilayer-v6.mp4`}
          data-poster={`${ambientRoot}/living-room-multilayer-v6-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
        <video
          class="living-room__fallback"
          data-room-video="night"
          data-src={`${ambientRoot}/living-room-night-v5.mp4`}
          data-poster={`${ambientRoot}/living-room-night-v5-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>

        <div
          class="living-room__stack"
          data-room-stack="day"
          aria-hidden="true"
        >
          <div class="living-room__plane living-room__plane--sky">
            <img
              data-room-layer-image="day"
              class="is-registered-sprite"
              style={registeredLayerStyle([548, 0, 924, 380])}
              data-src={`${parallaxRoot}/day/01-sky.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--harbor">
            <img
              data-room-layer-image="day"
              data-src={`${parallaxRoot}/day/03-harbor.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--boat">
            <div class="living-room__boat-rock">
              <img
                data-room-layer-image="day"
                class="is-registered-sprite"
                style={registeredLayerStyle([968, 185, 65, 80])}
                data-src={`${parallaxRoot}/day/04-sailboat.webp`}
                alt=""
              />
            </div>
          </div>
          <div class="living-room__plane living-room__plane--room">
            <img
              data-room-layer-image="day"
              data-src={`${parallaxRoot}/day/05-room-shell.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--shadow">
            <img
              data-room-layer-image="day"
              class="is-registered-sprite"
              style={registeredLayerStyle([534, 753, 788, 188])}
              data-src={`${parallaxRoot}/day/06-table-shadow.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--table">
            <img
              data-room-layer-image="day"
              class="is-registered-sprite"
              style={registeredLayerStyle([553, 543, 714, 344])}
              data-src={`${parallaxRoot}/day/07-coffee-table.webp`}
              alt=""
            />
            <div class="living-room__steam" aria-hidden="true">
              {Array.from({ length: 7 }, (_, index) => (
                <span style={`--steam-index:${index}`}></span>
              ))}
            </div>
          </div>
        </div>

        <div
          class="living-room__stack"
          data-room-stack="night"
          aria-hidden="true"
        >
          <div class="living-room__plane living-room__plane--sky">
            <img
              data-room-layer-image="night"
              data-src={`${parallaxRoot}/night/01-sky.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--clouds">
            <img
              data-room-layer-image="night"
              class="is-registered-sprite"
              style={registeredLayerStyle([638, 46, 504, 147])}
              data-src={`${parallaxRoot}/night/02-clouds.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--harbor">
            <img
              data-room-layer-image="night"
              data-src={`${parallaxRoot}/night/03-harbor.webp`}
              alt=""
            />
            <div class="living-room__moon-reflection" aria-hidden="true">
              {Array.from({ length: 10 }, (_, index) => (
                <span style={`--reflection-index:${index}`}></span>
              ))}
            </div>
            <span class="living-room__lighthouse-glow" aria-hidden="true"></span>
          </div>
          <div class="living-room__plane living-room__plane--boat">
            <div class="living-room__boat-rock">
              <img
                data-room-layer-image="night"
                class="is-registered-sprite"
                style={registeredLayerStyle([968, 185, 65, 80])}
                data-src={`${parallaxRoot}/night/04-sailboat.webp`}
                alt=""
              />
            </div>
          </div>
          <div class="living-room__plane living-room__plane--room">
            <img
              data-room-layer-image="night"
              data-src={`${parallaxRoot}/night/05-room-shell.webp`}
              alt=""
            />
            <span class="living-room__lamp-glow is-left" aria-hidden="true"></span>
            <span class="living-room__lamp-glow is-right" aria-hidden="true"></span>
          </div>
          <div class="living-room__plane living-room__plane--shadow">
            <img
              data-room-layer-image="night"
              class="is-registered-sprite"
              style={registeredLayerStyle([533, 751, 790, 190])}
              data-src={`${parallaxRoot}/night/06-table-shadow.webp`}
              alt=""
            />
          </div>
          <div class="living-room__plane living-room__plane--table">
            <img
              data-room-layer-image="night"
              class="is-registered-sprite"
              style={registeredLayerStyle([553, 543, 714, 344])}
              data-src={`${parallaxRoot}/night/07-coffee-table.webp`}
              alt=""
            />
            <span class="living-room__device-glow" aria-hidden="true"></span>
            <div class="living-room__steam" aria-hidden="true">
              {Array.from({ length: 7 }, (_, index) => (
                <span style={`--steam-index:${index}`}></span>
              ))}
            </div>
          </div>
        </div>

        <div class="living-room__hotspot-plane">
          <button
            class="living-room__photo"
            type="button"
            data-photo-trigger
            aria-label="查看窗边相框，打开生活档案"
            disabled
          >
            <span class="living-room__photo-glow" aria-hidden="true"></span>
            <span class="living-room__photo-label" aria-hidden="true">
              <span>查看照片</span>
              <small>EXAMINE</small>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <p class="living-room__explore-cue" aria-hidden="true">
    <span>←</span>
    <span class="living-room__swipe-copy">左右滑动探索</span>
    <span class="living-room__edge-copy">将光标移至边缘探索</span>
    <span>→</span>
  </p>

  <a class="living-room__back" href="/" data-room-back aria-label="返回村庄">
    <span aria-hidden="true">←</span>
    <span>返回村庄</span>
  </a>

  <button
    class="living-room__theme-toggle"
    type="button"
    data-room-theme-toggle
    aria-label="切换为夜晚客厅"
    aria-pressed="false"
    disabled
  >
    <span class="living-room__theme-icon" data-room-theme-icon aria-hidden="true">☀</span>
    <span data-room-theme-label>白昼</span>
  </button>

  <p class="sr-only" data-room-status aria-live="polite">正在进入客厅</p>
  <CinematicSceneExitOverlay
    label="从主屋返回村庄的过渡动画"
    day={{
      src: '/media/living-room/transitions/house-door/door-day-v4-reverse.mp4',
      poster:
        '/media/living-room/transitions/house-door/door-day-v4-reverse-poster.webp'
    }}
    night={{
      src: '/media/living-room/transitions/house-door/door-night-v4-reverse.mp4',
      poster:
        '/media/living-room/transitions/house-door/door-night-v4-reverse-poster.webp'
    }}
  />
  <div class="living-room__curtain" data-room-curtain aria-hidden="true"></div>
</section>

<script>
  import { navigate } from 'astro:transitions/client';
  import { createAdaptiveCinematicViewport } from '@/utils/adaptiveCinematicViewport';
  import { createCinematicExitSequence } from '@/utils/cinematicExitSequence';
  import {
    createLayerBundleLoader,
    loadDeferredVideo,
    scheduleCinematicWarmup,
    showDeferredVideoPoster
  } from '@/utils/cinematicMediaLoader';
  import { createHorizontalDepthParallax } from '@/utils/horizontalDepthParallax';

  const SESSION_KEY = 'wisteria-hero-environment';

  type Environment = 'day' | 'night';
  type RoomState = 'arriving' | 'idle' | 'exiting';
  type Renderer = 'layers' | 'fallback';

  const fallbackMedia: Record<Environment, { src: string; poster: string }> = {
    day: {
      src: '/media/living-room/ambient/living-room-multilayer-v6.mp4',
      poster: '/media/living-room/ambient/living-room-multilayer-v6-poster.webp'
    },
    night: {
      src: '/media/living-room/ambient/living-room-night-v5.mp4',
      poster: '/media/living-room/ambient/living-room-night-v5-poster.webp'
    }
  };

  function getStoredEnvironment(): Environment | null {
    try {
      const stored = window.sessionStorage.getItem(SESSION_KEY);
      return stored === 'day' || stored === 'night' ? stored : null;
    } catch {
      return null;
    }
  }

  function getLocalEnvironment(): Environment {
    const hour = new Date().getHours();
    return hour >= 7 && hour < 19 ? 'day' : 'night';
  }

  function initialiseLivingRoom() {
    const root = document.querySelector<HTMLElement>('[data-living-room]');
    if (!root || root.dataset.ready === 'true') return;

    const viewport = root.querySelector<HTMLElement>('[data-room-viewport]');
    const stage = root.querySelector<HTMLElement>('[data-room-stage]');
    const photoTrigger = root.querySelector<HTMLButtonElement>('[data-photo-trigger]');
    const backLink = root.querySelector<HTMLAnchorElement>('[data-room-back]');
    const themeToggle = root.querySelector<HTMLButtonElement>('[data-room-theme-toggle]');
    const themeIcon = root.querySelector<HTMLElement>('[data-room-theme-icon]');
    const themeLabel = root.querySelector<HTMLElement>('[data-room-theme-label]');
    const status = root.querySelector<HTMLElement>('[data-room-status]');
    const exitOverlay = root.querySelector<HTMLElement>(
      '[data-cinematic-scene-exit]'
    );
    const dayVideo = root.querySelector<HTMLVideoElement>('[data-room-video="day"]');
    const nightVideo = root.querySelector<HTMLVideoElement>('[data-room-video="night"]');
    const dayStack = root.querySelector<HTMLElement>('[data-room-stack="day"]');
    const nightStack = root.querySelector<HTMLElement>('[data-room-stack="night"]');

    if (
      !viewport ||
      !stage ||
      !photoTrigger ||
      !backLink ||
      !themeToggle ||
      !themeIcon ||
      !themeLabel ||
      !status ||
      !exitOverlay ||
      !dayVideo ||
      !nightVideo ||
      !dayStack ||
      !nightStack
    ) return;

    root.dataset.ready = 'true';

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const videos: Record<Environment, HTMLVideoElement> = {
      day: dayVideo,
      night: nightVideo
    };
    const stacks: Record<Environment, HTMLElement> = {
      day: dayStack,
      night: nightStack
    };
    const bundleLoader = createLayerBundleLoader({
      stacks,
      imageSelector: '[data-room-layer-image]',
      signal
    });

    let environment: Environment = getStoredEnvironment() ?? getLocalEnvironment();
    let renderer: Renderer = 'fallback';
    let state: RoomState = 'arriving';
    let themeLoading = false;
    let arrivalTimer = 0;
    let navigationTimer = 0;
    let themeTimer = 0;

    const isDepthInteractive = () =>
      state === 'idle' &&
      !themeLoading &&
      renderer === 'layers' &&
      !document.hidden &&
      !reduceMotion.matches;

    const adaptiveViewport = createAdaptiveCinematicViewport({
      root,
      viewport,
      world: stage,
      signal,
      initialCenterRatio: 0.43,
      isInteractive: () => state === 'idle' && !themeLoading
    });

    const depth = createHorizontalDepthParallax({
      root,
      viewport,
      world: stage,
      signal,
      neutralCenterRatio: 0.43,
      isInteractive: isDepthInteractive,
      planes: [
        { property: '--depth-sky-x', maximumPercent: 0.15 },
        { property: '--depth-clouds-x', maximumPercent: 0.25 },
        { property: '--depth-harbor-x', maximumPercent: 0.35 },
        { property: '--depth-boat-x', maximumPercent: 0.45 },
        { property: '--depth-room-x', maximumPercent: 0.75 },
        { property: '--depth-shadow-x', maximumPercent: 1.05 },
        { property: '--depth-table-x', maximumPercent: 1.5 }
      ]
    });

    const setState = (next: RoomState) => {
      state = next;
      root.dataset.state = next;
      root.classList.toggle('is-ambient-paused', next !== 'idle');
      depth.setSuspended(!isDepthInteractive(), next !== 'idle');
    };

    const setRenderer = (next: Renderer) => {
      renderer = next;
      root.dataset.renderer = next;
      depth.setSuspended(!isDepthInteractive(), true);
    };

    const safelyPlay = (video: HTMLVideoElement) => {
      if (
        renderer !== 'fallback' ||
        reduceMotion.matches ||
        document.hidden ||
        state === 'exiting'
      ) return;
      video.muted = true;
      const playback = video.play();
      playback?.catch(() => {
        root.dataset.playback = `${environment}-poster`;
      });
    };

    const pauseVideos = () => {
      Object.values(videos).forEach((video) => video.pause());
    };

    const loadBundle = bundleLoader.load;
    let inactiveWarmupScheduled = false;
    const scheduleInactiveWarmup = () => {
      if (inactiveWarmupScheduled) return;
      inactiveWarmupScheduled = true;
      scheduleCinematicWarmup(() => {
        const inactive = environment === 'day' ? 'night' : 'day';
        return loadBundle(inactive);
      }, signal);
    };

    const activateFallback = (theme: Environment, play = true) => {
      loadDeferredVideo(videos[theme], fallbackMedia[theme]);
      if (play) safelyPlay(videos[theme]);
    };

    const showTheme = (
      next: Environment,
      nextRenderer: Renderer,
      initial = false
    ) => {
      const previous = environment;
      environment = next;
      root.dataset.environment = next;
      setRenderer(nextRenderer);

      if (nextRenderer === 'layers') {
        Object.values(videos).forEach((video) => {
          video.pause();
          if (!video.hasAttribute('src')) video.removeAttribute('poster');
        });
        stacks[next].classList.add('is-active');
        if (initial) {
          stacks[previous === next ? (next === 'day' ? 'night' : 'day') : previous]
            .classList.remove('is-active');
        } else if (previous !== next) {
          requestAnimationFrame(() => {
            stacks[previous].classList.remove('is-active');
          });
        }
      } else {
        stacks.day.classList.remove('is-active');
        stacks.night.classList.remove('is-active');
        videos[next].classList.add('is-active');
        videos[next === 'day' ? 'night' : 'day'].classList.remove('is-active');
        showDeferredVideoPoster(videos[next], fallbackMedia[next]);
        if (videos[next].hasAttribute('src')) safelyPlay(videos[next]);
      }

      const showingNight = next === 'night';
      themeToggle.setAttribute('aria-pressed', String(showingNight));
      themeToggle.setAttribute(
        'aria-label',
        showingNight ? '切换为白昼客厅' : '切换为夜晚客厅'
      );
      themeIcon.textContent = showingNight ? '☾' : '☀';
      themeLabel.textContent = showingNight ? '夜晚' : '白昼';
    };

    const persistEnvironment = () => {
      try {
        window.sessionStorage.setItem(SESSION_KEY, environment);
      } catch {
        // Theme switching remains available when storage is blocked.
      }
    };

    const finishArrival = () => {
      if (state !== 'arriving') return;
      window.clearTimeout(arrivalTimer);
      root.classList.add('is-revealed');
      status.textContent = '已进入客厅。可以查看窗边的相框。';

      window.setTimeout(() => {
        if (state !== 'arriving') return;
        setState('idle');
        root.classList.add('is-interactive');
        photoTrigger.disabled = false;
        themeToggle.disabled = false;
        depth.recalculate();
        scheduleInactiveWarmup();

      }, reduceMotion.matches ? 1 : 500);
    };

    const initialiseArtwork = async () => {
      root.dataset.environment = environment;
      showTheme(environment, 'fallback', true);
      arrivalTimer = window.setTimeout(
        finishArrival,
        reduceMotion.matches ? 1 : 1400
      );
      const layeredReady = await loadBundle(environment);
      if (signal.aborted || state === 'exiting') return;
      if (!layeredReady) activateFallback(environment);
      showTheme(environment, layeredReady ? 'layers' : 'fallback', true);
      finishArrival();
    };

    const switchTheme = async () => {
      if (state !== 'idle' || themeLoading) return;
      const next: Environment = environment === 'day' ? 'night' : 'day';
      themeLoading = true;
      root.classList.add('is-theme-loading');
      themeToggle.disabled = true;
      depth.setSuspended(true);
      status.textContent = next === 'night' ? '正在准备夜晚客厅' : '正在准备白昼客厅';

      const layeredReady = await loadBundle(next);
      if (signal.aborted || state !== 'idle') return;
      if (!layeredReady) activateFallback(next, false);
      showTheme(next, layeredReady ? 'layers' : 'fallback');
      persistEnvironment();
      status.textContent = next === 'night' ? '已切换为夜晚客厅' : '已切换为白昼客厅';

      window.clearTimeout(themeTimer);
      themeTimer = window.setTimeout(() => {
        themeLoading = false;
        root.classList.remove('is-theme-loading');
        themeToggle.disabled = false;
        depth.setSuspended(!isDepthInteractive());
      }, reduceMotion.matches ? 1 : 540);
    };

    const navigateTo = async (destination: string) => {
      window.clearTimeout(navigationTimer);
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(themeTimer);
      pauseVideos();

      try {
        await navigate(destination);
      } catch {
        window.location.assign(destination);
      }
    };

    const exitSequence = createCinematicExitSequence({
      overlay: exitOverlay,
      reduceMotion,
      signal,
      onComplete: () => navigateTo('/')
    });

    const startCurtainExit = (destination: string, message: string) => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-exiting');
      photoTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = message;
      adaptiveViewport.stopMotion(true);
      navigationTimer = window.setTimeout(
        () => navigateTo(destination),
        reduceMotion.matches ? 1 : 360
      );
    };

    const startVillageExit = () => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-returning');
      photoTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = '正在离开主屋并返回村庄';
      adaptiveViewport.stopMotion(true);
      pauseVideos();
      exitSequence.start(environment);
    };

    const resetAfterRestore = async () => {
      window.clearTimeout(navigationTimer);
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(themeTimer);
      root.classList.remove('is-exiting', 'is-returning', 'is-theme-loading');
      exitSequence.reset();
      themeLoading = false;
      const restored = getStoredEnvironment() ?? environment;
      const layeredReady = await loadBundle(restored);
      if (signal.aborted) return;
      if (!layeredReady) activateFallback(restored, false);
      showTheme(restored, layeredReady ? 'layers' : 'fallback', true);
      root.classList.add('is-revealed', 'is-interactive');
      backLink.removeAttribute('aria-disabled');
      photoTrigger.disabled = false;
      themeToggle.disabled = false;
      setState('idle');
      adaptiveViewport.recalculate(true);
      depth.recalculate();
      status.textContent = '已回到客厅。可以查看窗边的相框。';
    };

    void initialiseArtwork();

    themeToggle.addEventListener('click', () => {
      void switchTheme();
    }, { signal });

    photoTrigger.addEventListener('click', () => {
      startCurtainExit('/lifestyle/archive', '正在打开生活档案');
    }, { signal });

    backLink.addEventListener('click', (event) => {
      event.preventDefault();
      if (state === 'idle') startVillageExit();
    }, { signal });

    document.addEventListener('visibilitychange', () => {
      root.classList.toggle('is-document-hidden', document.hidden);
      if (document.hidden) {
        pauseVideos();
        depth.setSuspended(true, true);
      } else if (state === 'idle') {
        if (renderer === 'fallback') safelyPlay(videos[environment]);
        depth.setSuspended(!isDepthInteractive());
      }
    }, { signal });

    reduceMotion.addEventListener('change', () => {
      depth.setSuspended(!isDepthInteractive(), true);
      if (reduceMotion.matches) pauseVideos();
      else if (renderer === 'fallback') safelyPlay(videos[environment]);
    }, { signal });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) void resetAfterRestore();
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      lifecycle.abort();
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      exitSequence.pause();
      pauseVideos();
    }, { once: true, signal });
  }

  initialiseLivingRoom();
  document.addEventListener('astro:page-load', initialiseLivingRoom);
</script>

<style>
  .living-room {
    --depth-sky-x: 0px;
    --depth-clouds-x: 0px;
    --depth-harbor-x: 0px;
    --depth-boat-x: 0px;
    --depth-room-x: 0px;
    --depth-shadow-x: 0px;
    --depth-table-x: 0px;
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #101d1b;
    color: #fff8e7;
  }

  .living-room__viewport {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    outline: none;
    overscroll-behavior: contain;
  }

  .living-room__viewport:focus-visible {
    outline: 3px solid #ffd64f;
    outline-offset: -5px;
  }

  .living-room__stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, calc(100vh * 16 / 9));
    height: max(100vh, calc(100vw * 9 / 16));
    overflow: hidden;
    transform: translate(-50%, -50%);
  }

  .living-room__camera {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: scale(1.035);
    transform-origin: 50% 50%;
  }

  .living-room.has-world-overflow .living-room__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
