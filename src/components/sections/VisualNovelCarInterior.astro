---
import CinematicSceneExitOverlay from '@/components/media/CinematicSceneExitOverlay.astro';
import SpatialEffectToggle from '@/components/media/SpatialEffectToggle.astro';

const mediaRoot = '/media/car-interior';
const parallaxRoot = '/media/car-interior/parallax';
const registeredLayerStyle = ([x, y, width, height]: number[]) =>
  `--asset-x:${x / 16.72}%;--asset-y:${y / 9.41}%;` +
  `--asset-width:${width / 16.72}%;--asset-height:${height / 9.41}%`;
---

<section
  class="travel-cockpit is-ambient-paused"
  data-travel-cockpit
  data-state="arriving"
  data-renderer="fallback"
  aria-label="复古未来汽车里的旅行驾驶舱"
>
  <div
    class="travel-cockpit__viewport"
    data-cockpit-viewport
    tabindex="0"
    aria-label="汽车驾驶舱全景；画面较宽时可以左右探索"
  >
    <div class="travel-cockpit__stage" data-cockpit-stage>
      <video
        class="travel-cockpit__video travel-cockpit__arrival is-active"
        data-arrival-video="day"
        data-src={`${mediaRoot}/transitions/cockpit-rise/car-interior-rise-day-v1.mp4`}
        data-poster={`${mediaRoot}/transitions/cockpit-rise/car-interior-rise-day-v1-poster.webp`}
        muted
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
      <video
        class="travel-cockpit__video travel-cockpit__arrival"
        data-arrival-video="night"
        data-src={`${mediaRoot}/transitions/cockpit-rise/car-interior-rise-night-v1.mp4`}
        data-poster={`${mediaRoot}/transitions/cockpit-rise/car-interior-rise-night-v1-poster.webp`}
        muted
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
      <div class="travel-cockpit__camera">
        <video
          class="travel-cockpit__video travel-cockpit__ambient"
          data-ambient-video="day"
          data-src={`${mediaRoot}/ambient/car-interior-day-v1.mp4`}
          data-poster={`${mediaRoot}/ambient/car-interior-day-v1-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>
        <video
          class="travel-cockpit__video travel-cockpit__ambient"
          data-ambient-video="night"
          data-src={`${mediaRoot}/ambient/car-interior-night-v1.mp4`}
          data-poster={`${mediaRoot}/ambient/car-interior-night-v1-poster.webp`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        ></video>

        {(['day', 'night'] as const).map((theme) => (
          <div
            class="travel-cockpit__stack"
            data-cockpit-stack={theme}
            aria-hidden="true"
          >
            <div class="travel-cockpit__plane travel-cockpit__plane--exterior">
              <img
                data-cockpit-layer-image={theme}
                data-src={`${parallaxRoot}/${theme}/01-exterior.webp`}
                alt=""
              />
            </div>
            <div class="travel-cockpit__plane travel-cockpit__plane--shell">
              <img
                data-cockpit-layer-image={theme}
                data-src={`${parallaxRoot}/${theme}/02-cockpit-shell.webp`}
                alt=""
              />
            </div>
            <div class="travel-cockpit__plane travel-cockpit__plane--charm">
              <div class="travel-cockpit__charm-swing">
                <img
                  data-cockpit-layer-image={theme}
                  class="is-registered-sprite"
                  style={registeredLayerStyle([698, 226, 184, 135])}
                  data-src={`${parallaxRoot}/${theme}/03-buddha-charm.webp`}
                  alt=""
                />
              </div>
            </div>
            <div class="travel-cockpit__plane travel-cockpit__plane--seat">
              <img
                data-cockpit-layer-image={theme}
                class="is-registered-sprite"
                style={registeredLayerStyle([16, 844, 1640, 97])}
                data-src={`${parallaxRoot}/${theme}/04-front-seat.webp`}
                alt=""
              />
            </div>
          </div>
        ))}

        <div class="travel-cockpit__hotspot-plane">
          <button
            class="travel-cockpit__map"
            type="button"
            data-map-trigger
            aria-label="查看副驾驶仪表台上的地图，打开旅行档案"
            disabled
          >
            <span class="travel-cockpit__map-glow" aria-hidden="true"></span>
            <span class="travel-cockpit__map-label" aria-hidden="true">
              <span>查看地图</span>
              <small>TRAVEL LOG</small>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <p class="travel-cockpit__arrival-skip" aria-hidden="true">
    点击跳过
  </p>
  <p class="travel-cockpit__explore-cue" aria-hidden="true">
    <span>←</span>
    <span class="travel-cockpit__swipe-copy">左右滑动探索</span>
    <span class="travel-cockpit__edge-copy">将光标移至边缘探索</span>
    <span>→</span>
  </p>

  <a
    class="travel-cockpit__back"
    href="/"
    data-cockpit-back
    aria-label="返回村庄"
  >
    <span aria-hidden="true">←</span>
    <span>返回村庄</span>
  </a>

  <button
    class="travel-cockpit__theme-toggle"
    type="button"
    data-cockpit-theme-toggle
    aria-label="切换为夜晚驾驶舱"
    aria-pressed="false"
    disabled
  >
    <span
      class="travel-cockpit__theme-icon"
      data-cockpit-theme-icon
      aria-hidden="true"
    >☀</span>
    <span data-cockpit-theme-label>白昼</span>
  </button>

  <SpatialEffectToggle className="travel-cockpit__spatial-toggle" />

  <p class="sr-only" data-cockpit-status aria-live="polite">
    正在坐进汽车
  </p>
  <CinematicSceneExitOverlay
    label="从汽车驾驶舱返回村庄的过渡动画"
    day={{
      src:
        '/media/car-interior/transitions/driver-door/driver-door-day-v6-reverse.mp4',
      poster:
        '/media/car-interior/transitions/driver-door/driver-door-day-v6-reverse-poster.webp'
    }}
    night={{
      src:
        '/media/car-interior/transitions/driver-door/driver-door-night-v6-reverse.mp4',
      poster:
        '/media/car-interior/transitions/driver-door/driver-door-night-v6-reverse-poster.webp'
    }}
  />
  <div
    class="travel-cockpit__curtain"
    data-cockpit-curtain
    aria-hidden="true"
  ></div>
</section>

<script>
  import { navigate } from 'astro:transitions/client';
  import { createAdaptiveCinematicViewport } from '@/utils/adaptiveCinematicViewport';
  import { createCinematicExitSequence } from '@/utils/cinematicExitSequence';
  import {
    createLayerBundleLoader,
    loadDeferredVideo,
    releaseDeferredVideo,
    scheduleCinematicWarmup
  } from '@/utils/cinematicMediaLoader';
  import { createHorizontalDepthParallax } from '@/utils/horizontalDepthParallax';
  import { createDeviceOrientationSpatialEffect } from '@/utils/deviceOrientationSpatialEffect';

  const SESSION_KEY = 'wisteria-hero-environment';

  type Environment = 'day' | 'night';
  type CockpitState = 'arriving' | 'idle' | 'exiting';

  const arrivalMedia: Record<Environment, { src: string; poster: string }> = {
    day: {
      src: '/media/car-interior/transitions/cockpit-rise/car-interior-rise-day-v1.mp4',
      poster: '/media/car-interior/transitions/cockpit-rise/car-interior-rise-day-v1-poster.webp'
    },
    night: {
      src: '/media/car-interior/transitions/cockpit-rise/car-interior-rise-night-v1.mp4',
      poster: '/media/car-interior/transitions/cockpit-rise/car-interior-rise-night-v1-poster.webp'
    }
  };
  const ambientMedia: Record<Environment, { src: string; poster: string }> = {
    day: {
      src: '/media/car-interior/ambient/car-interior-day-v1.mp4',
      poster: '/media/car-interior/ambient/car-interior-day-v1-poster.webp'
    },
    night: {
      src: '/media/car-interior/ambient/car-interior-night-v1.mp4',
      poster: '/media/car-interior/ambient/car-interior-night-v1-poster.webp'
    }
  };

  function getStoredEnvironment(): Environment | null {
    try {
      const stored = window.sessionStorage.getItem(SESSION_KEY);
      return stored === 'day' || stored === 'night' ? stored : null;
    } catch {
      return null;
    }
  }

  function getLocalEnvironment(): Environment {
    const hour = new Date().getHours();
    return hour >= 7 && hour < 19 ? 'day' : 'night';
  }

  function initialiseTravelCockpit() {
    const root = document.querySelector<HTMLElement>('[data-travel-cockpit]');
    if (!root || root.dataset.ready === 'true') return;

    const viewport = root.querySelector<HTMLElement>('[data-cockpit-viewport]');
    const stage = root.querySelector<HTMLElement>('[data-cockpit-stage]');
    const dayArrival = root.querySelector<HTMLVideoElement>(
      '[data-arrival-video="day"]'
    );
    const nightArrival = root.querySelector<HTMLVideoElement>(
      '[data-arrival-video="night"]'
    );
    const dayAmbient = root.querySelector<HTMLVideoElement>(
      '[data-ambient-video="day"]'
    );
    const nightAmbient = root.querySelector<HTMLVideoElement>(
      '[data-ambient-video="night"]'
    );
    const dayStack = root.querySelector<HTMLElement>(
      '[data-cockpit-stack="day"]'
    );
    const nightStack = root.querySelector<HTMLElement>(
      '[data-cockpit-stack="night"]'
    );
    const mapTrigger = root.querySelector<HTMLButtonElement>(
      '[data-map-trigger]'
    );
    const backLink = root.querySelector<HTMLAnchorElement>(
      '[data-cockpit-back]'
    );
    const themeToggle = root.querySelector<HTMLButtonElement>(
      '[data-cockpit-theme-toggle]'
    );
    const themeIcon = root.querySelector<HTMLElement>(
      '[data-cockpit-theme-icon]'
    );
    const themeLabel = root.querySelector<HTMLElement>(
      '[data-cockpit-theme-label]'
    );
    const spatialToggle = root.querySelector<HTMLButtonElement>(
      '[data-spatial-effect-toggle]'
    );
    const status = root.querySelector<HTMLElement>(
      '[data-cockpit-status]'
    );
    const exitOverlay = root.querySelector<HTMLElement>(
      '[data-cinematic-scene-exit]'
    );

    if (
      !viewport ||
      !stage ||
      !dayArrival ||
      !nightArrival ||
      !dayAmbient ||
      !nightAmbient ||
      !dayStack ||
      !nightStack ||
      !mapTrigger ||
      !backLink ||
      !themeToggle ||
      !themeIcon ||
      !themeLabel ||
      !spatialToggle ||
      !status ||
      !exitOverlay
    ) return;

    root.dataset.ready = 'true';

    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );
    const arrivals: Record<Environment, HTMLVideoElement> = {
      day: dayArrival,
      night: nightArrival
    };
    const ambients: Record<Environment, HTMLVideoElement> = {
      day: dayAmbient,
      night: nightAmbient
    };
    const stacks: Record<Environment, HTMLElement> = {
      day: dayStack,
      night: nightStack
    };
    const bundleLoader = createLayerBundleLoader({
      stacks,
      imageSelector: '[data-cockpit-layer-image]',
      signal
    });
    const allVideos = [
      ...Object.values(arrivals),
      ...Object.values(ambients)
    ];

    let environment: Environment =
      getStoredEnvironment() ?? getLocalEnvironment();
    let activeArrival = arrivals[environment];
    let activeAmbient = ambients[environment];
    let state: CockpitState = 'arriving';
    let renderer: 'layers' | 'fallback' = 'fallback';
    let themeLoading = false;
    let arrivalStarted = false;
    let settling = false;
    let readyTimer = 0;
    let arrivalTimer = 0;
    let navigationTimer = 0;
    let themeTimer = 0;

    const isDepthInteractive = () =>
      state === 'idle' &&
      renderer === 'layers' &&
      !themeLoading &&
      !document.hidden &&
      !reduceMotion.matches;

    const adaptiveViewport = createAdaptiveCinematicViewport({
      root,
      viewport,
      world: stage,
      signal,
      initialCenterRatio: 0.62,
      isInteractive: () => state === 'idle'
    });

    const depth = createHorizontalDepthParallax({
      root,
      viewport,
      world: stage,
      signal,
      neutralCenterRatio: 0.62,
      isInteractive: isDepthInteractive,
      planes: [
        {
          property: '--depth-exterior-x',
          maximumPercent: 0.3,
          spatialMaximumPercent: -0.42
        },
        {
          property: '--depth-shell-x',
          maximumPercent: 0.75,
          spatialMaximumPercent: 0
        },
        {
          property: '--depth-charm-x',
          maximumPercent: 1.05,
          spatialMaximumPercent: 0.68
        },
        {
          property: '--depth-seat-x',
          maximumPercent: 1.5,
          spatialMaximumPercent: 1.35
        }
      ]
    });

    const spatial = createDeviceOrientationSpatialEffect({
      button: spatialToggle,
      signal,
      axes: 'horizontal',
      isInteractive: isDepthInteractive,
      onFocus: ({ x }) => depth.setSpatialFocus(x),
      onStatus: (message) => {
        if (message) status.textContent = message;
      }
    });

    const setState = (next: CockpitState) => {
      state = next;
      root.dataset.state = next;
      root.classList.toggle('is-ambient-paused', next !== 'idle');
      depth.setSuspended(
        next !== 'idle' || renderer !== 'layers' || themeLoading,
        next !== 'idle'
      );
      spatial.setSuspended(!isDepthInteractive(), next !== 'idle');
    };

    const pauseAll = () => {
      allVideos.forEach((video) => video.pause());
    };

    const loadBundle = bundleLoader.load;
    let inactiveWarmupScheduled = false;
    const scheduleInactiveWarmup = () => {
      if (inactiveWarmupScheduled) return;
      inactiveWarmupScheduled = true;
      scheduleCinematicWarmup(() => {
        const inactive = environment === 'day' ? 'night' : 'day';
        return loadBundle(inactive);
      }, signal);
    };

    const setRenderer = (next: 'layers' | 'fallback') => {
      renderer = next;
      root.dataset.renderer = next;
      if (next === 'layers') {
        Object.values(ambients).forEach((video) => video.pause());
      }
      depth.setSuspended(
        state !== 'idle' || next !== 'layers' || themeLoading,
        true
      );
      spatial.setSuspended(!isDepthInteractive(), true);
    };

    const safelyPlay = (video: HTMLVideoElement) => {
      if (reduceMotion.matches || document.hidden || state === 'exiting') {
        return Promise.resolve();
      }

      const playback = video.play();
      return playback ?? Promise.resolve();
    };

    const updateThemeControls = (
      announce = false,
      persist = false
    ) => {
      root.dataset.environment = environment;
      const showingNight = environment === 'night';
      themeToggle.setAttribute('aria-pressed', String(showingNight));
      themeToggle.setAttribute(
        'aria-label',
        showingNight
          ? '切换为白昼驾驶舱'
          : '切换为夜晚驾驶舱'
      );
      themeIcon.textContent = showingNight ? '☾' : '☀';
      themeLabel.textContent = showingNight ? '夜晚' : '白昼';

      if (announce) {
        status.textContent = showingNight
          ? '已切换为夜晚驾驶舱'
          : '已切换为白昼驾驶舱';
      }

      if (persist) {
        try {
          window.sessionStorage.setItem(SESSION_KEY, environment);
        } catch {
          // Theme switching remains available when storage is blocked.
        }
      }
    };

    const enableInteraction = () => {
      setState('idle');
      root.classList.add('is-interactive');
      mapTrigger.disabled = false;
      themeToggle.disabled = false;
      backLink.removeAttribute('aria-disabled');
      depth.setSuspended(renderer !== 'layers');
      spatial.setSuspended(!isDepthInteractive());
      depth.recalculate();
      status.textContent =
        '已坐进汽车。可以查看副驾驶仪表台上的地图。';
      scheduleInactiveWarmup();
    };

    const settleToAmbient = async (posterOnly = false) => {
      if (settling || state === 'exiting') return;
      settling = true;
      window.clearTimeout(readyTimer);
      window.clearTimeout(arrivalTimer);

      root.classList.add('is-revealed', 'is-settled');
      const layeredReady = await loadBundle(environment);
      if (signal.aborted || root.dataset.state === 'exiting') return;
      setRenderer(layeredReady ? 'layers' : 'fallback');
      stacks.day.classList.toggle('is-active', environment === 'day');
      stacks.night.classList.toggle('is-active', environment === 'night');

      if (!layeredReady) {
        loadDeferredVideo(activeAmbient, ambientMedia[environment]);
        activeAmbient.currentTime = 0;
        activeAmbient.classList.add('is-active');
        if (!posterOnly && !reduceMotion.matches && !document.hidden) {
          safelyPlay(activeAmbient).catch(() => {
            root.dataset.playback = `${environment}-ambient-poster`;
          });
        } else {
          activeAmbient.pause();
          root.dataset.playback = `${environment}-ambient-poster`;
        }
      } else {
        Object.values(ambients).forEach((video) => {
          video.pause();
          video.classList.remove('is-active');
        });
      }

      window.setTimeout(() => {
        activeArrival.classList.remove('is-active');
        releaseDeferredVideo(activeArrival);
        enableInteraction();
      }, reduceMotion.matches ? 1 : 520);
    };

    const beginArrival = () => {
      if (arrivalStarted || settling || state !== 'arriving') return;
      arrivalStarted = true;
      window.clearTimeout(readyTimer);
      root.classList.add('is-revealed');

      loadDeferredVideo(activeArrival, arrivalMedia[environment]);
      activeArrival.currentTime = 0;
      safelyPlay(activeArrival).catch(() => settleToAmbient(true));
      arrivalTimer = window.setTimeout(
        () => settleToAmbient(false),
        4400
      );
    };

    const setInitialEnvironment = () => {
      activeArrival = arrivals[environment];
      activeAmbient = ambients[environment];
      (Object.entries(arrivals) as [Environment, HTMLVideoElement][]).forEach(
        ([name, video]) => {
          video.classList.toggle('is-active', name === environment);
        }
      );
      Object.values(ambients).forEach((video) => {
        video.classList.remove('is-active');
      });
      stacks.day.classList.toggle('is-active', environment === 'day');
      stacks.night.classList.toggle('is-active', environment === 'night');
      updateThemeControls();
      void loadBundle(environment);
    };

    const switchEnvironment = async (next: Environment) => {
      if (
        state !== 'idle' ||
        next === environment ||
        themeLoading
      ) return;
      const previous = activeAmbient;
      window.clearTimeout(themeTimer);
      themeLoading = true;
      themeToggle.disabled = true;
      depth.setSuspended(true);
      spatial.setSuspended(true);
      const layeredReady = await loadBundle(next);
      if (signal.aborted || state !== 'idle') return;
      environment = next;
      activeAmbient = ambients[next];
      setRenderer(layeredReady ? 'layers' : 'fallback');
      stacks.day.classList.toggle('is-active', next === 'day');
      stacks.night.classList.toggle('is-active', next === 'night');

      if (
        !layeredReady &&
        Number.isFinite(previous.currentTime) &&
        Number.isFinite(activeAmbient.duration) &&
        activeAmbient.duration > 0
      ) {
        activeAmbient.currentTime =
          previous.currentTime % activeAmbient.duration;
      }

      if (!layeredReady) {
        loadDeferredVideo(activeAmbient, ambientMedia[next]);
        activeAmbient.classList.add('is-active');
        safelyPlay(activeAmbient).catch(() => {
          root.dataset.playback = `${environment}-ambient-poster`;
        });
        requestAnimationFrame(() => {
          previous.classList.remove('is-active');
        });
      } else {
        Object.values(ambients).forEach((video) => {
          video.pause();
          video.classList.remove('is-active');
        });
      }
      updateThemeControls(true, true);
      themeTimer = window.setTimeout(() => {
        previous.pause();
        themeLoading = false;
        themeToggle.disabled = false;
        depth.setSuspended(renderer !== 'layers');
        spatial.setSuspended(!isDepthInteractive());
      }, reduceMotion.matches ? 1 : 560);
    };

    const navigateTo = async (destination: string) => {
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      pauseAll();

      try {
        await navigate(destination);
      } catch {
        window.location.assign(destination);
      }
    };

    const exitSequence = createCinematicExitSequence({
      overlay: exitOverlay,
      reduceMotion,
      signal,
      onComplete: () => navigateTo('/')
    });

    const startCurtainExit = (destination: string, message: string) => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-exiting');
      mapTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = message;
      adaptiveViewport.stopMotion(true);
      navigationTimer = window.setTimeout(
        () => navigateTo(destination),
        reduceMotion.matches ? 1 : 360
      );
    };

    const startVillageExit = () => {
      if (state !== 'idle') return;
      setState('exiting');
      root.classList.remove('is-interactive');
      root.classList.add('is-returning');
      mapTrigger.disabled = true;
      themeToggle.disabled = true;
      backLink.setAttribute('aria-disabled', 'true');
      status.textContent = '正在离开汽车并返回村庄';
      adaptiveViewport.stopMotion(true);
      pauseAll();
      exitSequence.start(environment);
    };

    const resetAfterRestore = () => {
      window.clearTimeout(readyTimer);
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      settling = true;
      arrivalStarted = true;
      root.classList.remove('is-exiting');
      root.classList.remove('is-returning');
      exitSequence.reset();
      root.classList.add(
        'is-revealed',
        'is-settled',
        'is-interactive'
      );
      Object.values(arrivals).forEach((video) => {
        video.pause();
        video.classList.remove('is-active');
      });
      environment = getStoredEnvironment() ?? environment;
      activeAmbient = ambients[environment];
      stacks.day.classList.toggle('is-active', environment === 'day');
      stacks.night.classList.toggle('is-active', environment === 'night');
      (Object.entries(ambients) as [Environment, HTMLVideoElement][]).forEach(
        ([name, video]) => {
          video.classList.toggle('is-active', name === environment);
          if (name !== environment) video.pause();
        }
      );
      mapTrigger.disabled = false;
      themeToggle.disabled = false;
      backLink.removeAttribute('aria-disabled');
      setState('idle');
      adaptiveViewport.recalculate(true);
      depth.recalculate();
      updateThemeControls();
      status.textContent =
        '已回到汽车。可以查看副驾驶仪表台上的地图。';
      if (
        renderer === 'fallback' &&
        !reduceMotion.matches &&
        !document.hidden
      ) {
        safelyPlay(activeAmbient).catch(() => undefined);
      }
    };

    allVideos.forEach((video) => {
      video.muted = true;
    });
    setInitialEnvironment();
    loadDeferredVideo(activeArrival, arrivalMedia[environment]);

    activeArrival.addEventListener('loadeddata', beginArrival, {
      signal
    });
    activeArrival.addEventListener('canplay', beginArrival, {
      signal
    });
    activeArrival.addEventListener(
      'ended',
      () => settleToAmbient(false),
      { signal }
    );
    activeArrival.addEventListener(
      'error',
      () => settleToAmbient(true),
      { signal }
    );
    Object.values(ambients).forEach((video) => {
      video.addEventListener('error', () => {
        if (video === activeAmbient) {
          root.dataset.playback = `${environment}-ambient-poster`;
        }
      }, { signal });
    });

    if (reduceMotion.matches) {
      settleToAmbient(true);
    } else if (
      activeArrival.readyState >=
      HTMLMediaElement.HAVE_CURRENT_DATA
    ) {
      requestAnimationFrame(beginArrival);
    } else {
      readyTimer = window.setTimeout(
        () => settleToAmbient(true),
        1400
      );
    }

    themeToggle.addEventListener('click', () => {
      void switchEnvironment(environment === 'day' ? 'night' : 'day');
    }, { signal });

    viewport.addEventListener('click', () => {
      if (state !== 'arriving' || !arrivalStarted || settling) return;
      status.textContent = '已跳过坐进汽车的过渡动画';
      settleToAmbient(false);
    }, { signal });

    mapTrigger.addEventListener('click', () => {
      startCurtainExit('/travel/archive', '正在打开旅行档案');
    }, { signal });

    mapTrigger.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      startCurtainExit('/travel/archive', '正在打开旅行档案');
    }, { signal });

    backLink.addEventListener('click', (event) => {
      event.preventDefault();
      startVillageExit();
    }, { signal });

    document.addEventListener('visibilitychange', () => {
      root.classList.toggle('is-document-hidden', document.hidden);
      if (document.hidden) {
        pauseAll();
        depth.setSuspended(true, true);
        spatial.setSuspended(true, true);
      } else if (state === 'idle') {
        if (renderer === 'fallback') {
          safelyPlay(activeAmbient).catch(() => undefined);
        }
        depth.setSuspended(renderer !== 'layers');
        spatial.setSuspended(!isDepthInteractive());
      } else if (state === 'arriving' && arrivalStarted) {
        safelyPlay(activeArrival).catch(() => settleToAmbient(true));
      }
    }, { signal });

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) resetAfterRestore();
    }, { signal });

    document.addEventListener('astro:before-swap', () => {
      lifecycle.abort();
      window.clearTimeout(readyTimer);
      window.clearTimeout(arrivalTimer);
      window.clearTimeout(navigationTimer);
      window.clearTimeout(themeTimer);
      exitSequence.pause();
      allVideos.forEach((video) => releaseDeferredVideo(video));
    }, { once: true, signal });
  }

  initialiseTravelCockpit();
  document.addEventListener(
    'astro:page-load',
    initialiseTravelCockpit
  );
</script>

